#!/usr/bin/env python3
"""verify-rui: drive a pinned Rui build in an isolated synthetic HOME/Store.

Run `verify-rui --help` and read ../SKILL.md. Every Rui invocation this tool
makes passes an explicit --store under the run's synthetic HOME; nothing reads
or writes the user's default Store, credentials or tmux server.
"""
import argparse
import functools
import hashlib
import html
import io
import math
import contextlib
import json
import os
import pathlib
import re
import select
import shlex
import shutil
import signal
import site
import subprocess
import sys
import tarfile
import threading
import time

CACHE = pathlib.Path(os.environ.get("VERIFY_RUI_CACHE", pathlib.Path.home() / ".cache/verify-rui"))
SCRATCH_PARENT = pathlib.Path("/private/tmp" if sys.platform == "darwin" else "/tmp")  # short paths: Unix socket limits
HERE = pathlib.Path(__file__).resolve()
REPO_URL = "https://github.com/DivyanshGolyan/rui.git"


def now_ns():
    return time.monotonic_ns()


def wall():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def die(message, code=2):
    print(f"verify-rui: {message}", file=sys.stderr)
    sys.exit(code)


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def append_jsonl(path, record):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as handle:
        handle.write(json.dumps(record, ensure_ascii=False) + "\n")


def read_jsonl(path):
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def atomic_write(path, text):
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(text)
    os.replace(temporary, path)


def process_start(pid):
    """Process start time and command line, used to prove a PID is still ours."""
    result = subprocess.run(["ps", "-o", "stat=,lstart=,command=", "-p", str(pid)], capture_output=True, text=True)
    line = result.stdout.strip()
    if result.returncode != 0 or not line:
        return None
    state, _, line = line.partition(" ")
    if state.startswith("Z"):
        return None  # Exited owned children may await the container's reaper.
    line = line.lstrip()
    return line[:24].strip(), line[24:].strip()


# ---------------------------------------------------------------- run state


class Run:
    def __init__(self, evidence_root):
        self.root = pathlib.Path(evidence_root).resolve()
        meta = self.root / "run.json"
        if not meta.exists():
            die(f"not a verify-rui run: {self.root}")
        self.meta = json.loads(meta.read_text())
        self.scratch = pathlib.Path(self.meta["scratch"])
        self.home = pathlib.Path(self.meta["home"])
        self.store = pathlib.Path(self.meta["store"])
        self.project = pathlib.Path(self.meta["project"])
        self.rui = pathlib.Path(self.meta["binary"])
        self.evidence = self.root / "evidence"
        self.sock = self.scratch / "tmux.sock"

    def env(self, **extra):
        # A minimal, explicit environment: no inherited credentials or Store.
        env = {
            "HOME": str(self.home),
            "PYTHONUSERBASE": site.getuserbase(),
            "PATH": f"{self.rui.parent}:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin",
            "TERM": "xterm-256color",
            "LANG": "en_US.UTF-8",
            "TMPDIR": str(self.scratch / "tmp"),
            "XDG_CONFIG_HOME": str(self.home / ".config"),
            "XDG_STATE_HOME": str(self.home / ".local/state"),
            "XDG_DATA_HOME": str(self.home / ".local/share"),
            "TMUX_TMPDIR": str(self.scratch / "tmux"),
        }
        env.update(extra)
        return env

    def sid(self, name):
        """The ID `session start` gave a seeded Session, or NAME itself."""
        return self.meta.get("sessions", {}).get(name, name)

    def rui_cmd(self, *args, timeout=30, log=True, input=None):
        """One-shot Rui CLI call with explicit --store; logged with its result."""
        args = [str(a) for a in args]
        # `request list` is the only command without --store: it lists captures
        # under this run's synthetic HOME, never the user's.
        if "--store" not in args and args[:2] != ["request", "list"]:
            die(f"refusing Rui call without --store: {args}")
        started = now_ns()
        result = subprocess.run([str(self.rui), *args], env=self.env(), cwd=self.project,
                                capture_output=True, text=True, timeout=timeout, input=input)
        if log:
            append_jsonl(self.evidence / "commands.jsonl", {
                "t_ns": started, "t_end_ns": now_ns(), "argv": [str(self.rui), *args],
                "rc": result.returncode, "stdout": result.stdout, "stderr": result.stderr})
        return result

    def own(self, kind, pid, **facts):
        start = process_start(pid)
        append_jsonl(self.root / "owned.jsonl", {"kind": kind, "pid": pid, "lstart": start and start[0],
                                                 "command": start and start[1], **facts})

    def owned(self):
        return read_jsonl(self.root / "owned.jsonl")

    def tmux(self, *args, check=True):
        result = subprocess.run(["tmux", "-S", str(self.sock), *map(str, args)], capture_output=True,
                                text=True, env=self.env())
        if check and result.returncode != 0:
            die(f"tmux {' '.join(map(str, args))} failed: {result.stderr.strip()}")
        return result

    def term_dir(self, name):
        return self.evidence / "terms" / name


def store_arg(run):
    return ["--store", str(run.store)]


# ---------------------------------------------------------------- build


def cmd_build(args):
    sha = args.sha
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        die("build needs a full 40-hex commit SHA")
    source = pathlib.Path(args.source).resolve() if args.source else CACHE / "src" / sha
    build = CACHE / "builds" / sha
    manifest = build / "manifest.json"
    if manifest.exists() and not args.force:
        print(json.dumps(json.loads(manifest.read_text()), indent=1))
        return
    origin = args.repo or str(HERE.parents[4])
    if not source.exists():
        source.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "-C", origin, "fetch", "--quiet", "origin", sha], check=False)
        subprocess.run(["git", "-C", origin, "worktree", "add", "--detach", str(source), sha], check=True)
    head = subprocess.run(["git", "-C", str(source), "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", str(source), "status", "--porcelain", "--untracked-files=no"],
                           capture_output=True, text=True, check=True).stdout
    if head != sha or dirty:
        die(f"source {source} is not a clean checkout of {sha} (HEAD {head}, dirty={bool(dirty)})")
    tree = subprocess.run(["git", "-C", str(source), "rev-parse", "HEAD^{tree}"], capture_output=True, text=True, check=True).stdout.strip()
    build.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ)
    if args.pkg_dir:
        env["ZIG_LOCAL_PKG_DIR"] = args.pkg_dir
    log = build / "build.log"
    started = time.monotonic()
    with open(log, "w") as handle:
        result = subprocess.run(["zig", "build", "-Doptimize=ReleaseSafe", "--summary", "all"], cwd=source,
                                env=env, stdout=handle, stderr=subprocess.STDOUT)
        if result.returncode == 0 and not args.no_screen:
            # The committed-screen observer's terminal emulator, for the tap.
            result = subprocess.run(["zig", "build", "screen-emulator", "--prefix", str(build / "screen"), "--summary", "all"],
                                    cwd=source, env=env, stdout=handle, stderr=subprocess.STDOUT)
    if result.returncode != 0:
        die(f"zig build failed (rc={result.returncode}); see {log}")
    screen_library = None if args.no_screen else next(path for path in sorted((build / "screen/lib").iterdir()) if not path.is_symlink())
    bin_dir = build / "bin"
    if bin_dir.exists():
        shutil.rmtree(bin_dir)
    shutil.copytree(source / "zig-out/bin", bin_dir, symlinks=False)
    files = {p.name: sha256(p) for p in sorted(bin_dir.iterdir())}
    record = {"sha": sha, "tree": tree, "source": str(source), "binary": str(bin_dir / "rui"),
              "screen_library": str(screen_library) if screen_library else None,
              "screen_library_sha256": sha256(screen_library) if screen_library else None,
              "files_sha256": files, "optimize": "ReleaseSafe", "built_at": wall(),
              "build_seconds": round(time.monotonic() - started, 1),
              "zig": subprocess.run(["zig", "version"], capture_output=True, text=True).stdout.strip(),
              "host": os.uname().nodename, "macos": macos_version()}
    manifest.write_text(json.dumps(record, indent=1) + "\n")
    print(json.dumps(record, indent=1))


def load_build(sha):
    manifest = CACHE / "builds" / sha / "manifest.json"
    if not manifest.exists():
        die(f"no build for {sha}; run: verify-rui build {sha}")
    return json.loads(manifest.read_text())


def fixture_answer(text, n, answers="echo"):
    """One answer policy, shared by the echo and realistic fixture modes."""
    text = text or ""
    if "compact rich answer" in text:
        return """## What I changed

1. `retry.zig` checks the deadline.

```zig
pub fn next(self: *Retry, now: i64) ?u64 {
    if (now >= self.deadline) return null; // expired

    return 2;
}
```

| Case | Before | After |
| --- | --- | --- |
| Late request | waits 30 s | fails at once |
| 2 s left | waits 30 s | waits 2 s |

See the [retry policy notes](https://example.com/docs/retry-policy).
"""
    if "rich answer" in text:
        return """The retry loop sleeps before it checks the deadline, so a request that is already late still waits one more backoff.

## What I changed

1. `retry.zig` checks the deadline **before** sleeping.
2. The backoff is capped at the time left, not at a fixed 30 s.
3. Added a test for a deadline that expires mid-backoff.

```zig
pub fn next(self: *Retry, now: i64) ?u64 {
    if (now >= self.deadline) return null;
    const wait = @min(self.backoff, self.deadline - now);
    self.backoff *= 2;
    return wait;
}
```

| Case | Before | After |
| --- | --- | --- |
| Late request | waits 30 s | fails at once |
| 2 s left | waits 30 s | waits 2 s |

- All 214 tests pass.
- Nothing else calls `Retry.sleep`, so I removed it.

See the [retry policy notes](https://example.com/docs/retry-policy) for the reasoning. *One thing to check:* the cap changes the worst-case wait in `fetch.zig`.
"""
    if "long answer" in text:
        return "\n\n".join(f"Step {i}. " + "The Host keeps each Session in its Store and wakes it only when a model reply or a tool result arrives, so an idle Session costs no CPU. " * 2 for i in range(1, 15))
    if answers == "echo":
        return f"Fixture answer {n}: received {json.dumps(text, ensure_ascii=False)}"
    if "Seed" in text or "opened" in text:
        return "Ready. The project has a README and an empty `src` folder."
    return "The deadline check now runs before the backoff sleep, and the test suite passes (214 tests). I did not touch `fetch.zig`."

def fixture_summary(text, n, tool_count, answers="echo"):
    if answers == "realistic":
        return "The project has a README and an empty `src` folder. Two of the three commands failed: `exit 127` (command not found) and the usage check, which printed `unknown option --help`."
    return f"Fixture tool summary {n}: {tool_count} tool results for {json.dumps(text)}."


def require_screen(build):
    if not build.get("screen_library"):
        die("this build has no screen library")


# ---------------------------------------------------------------- fixture provider


def fixture_main(args):
    """Deterministic Responses endpoint. Every request and reply is logged.

    Policy (by the latest user text, or by a pending tool result):
      * after a function_call_output: echo tool summary, or believable prose in realistic mode
      * text containing "tool demonstration": three Bash calls (ls, exit 127, stderr+exit 1)
      * text containing "consent check": one 32-line Bash command (needs approval in ask mode)
      * text containing "long bash": one Bash command that sleeps 8 s
      * text containing "show environment": one Bash call that prints CLIENT_MARK, HOST_SECRET, `command -v brew` and PATH
      * text containing "start a child": one Bash call that starts Session "child" with "show environment"
      * text containing "relay to ID": one Bash call that sends "show environment" to Session ID as a peer
      * text containing "parallel bash": two Bash commands that sleep 12 s and 20 s, issued together
      * text containing "slow": the echo answer streamed slowly (~10 s in flight)
      * text containing "invalid output": a stream that is not JSON, so the Turn fails
      * text containing "rate limit": HTTP 429 with Retry-After 8 the first time, then the echo answer
      * text containing "rich answer": markdown with a heading, list, code, table and link
      * text containing "long answer": a fourteen-step answer
      * otherwise: "Fixture answer N: received <json of the exact text>" (echo), or realistic prose
    Unbounded: it never exhausts, so extra submissions stay visible instead of failing.
    """
    run = Run(args.run)
    sys.argv = [sys.argv[0], str(run.rui)]
    sys.path.insert(0, str(pathlib.Path(run.meta["source"]) / "tests/integration"))
    import http.server
    import model_fixture as fixture
    log = run.evidence / "provider.jsonl"
    bodies = run.evidence / "provider"
    bodies.mkdir(parents=True, exist_ok=True)
    lock = threading.Lock()
    counter = {"n": 0}
    limited = set()

    def bash(call, cmd, description):
        return ("bash", call, json.dumps({"cmd": cmd, "description": description, "timeout_ms": None}))

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def do_GET(self):
            body = json.dumps({"verify_rui_fixture": run.meta["id"]}).encode()
            self.send_response(200)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            received = now_ns()
            body = self.rfile.read(int(self.headers["Content-Length"]))
            with lock:
                counter["n"] += 1
                n = counter["n"]
            request = json.loads(body)
            items = request.get("input", [])
            last_user = next((i for i in reversed(range(len(items))) if items[i].get("role") == "user"), None)
            user_text = None
            if last_user is not None:
                content = items[last_user].get("content")
                user_text = content if isinstance(content, str) else "".join(
                    part.get("text", "") for part in content if isinstance(part, dict))
            tool_results = [i for i in items[(last_user or 0):] if i.get("type") == "function_call_output"]
            chunk_delay = 0
            with lock:
                refuse = bool(user_text and "rate limit" in user_text and not tool_results and user_text not in limited)
                if refuse:
                    limited.add(user_text)
            if refuse:
                (bodies / f"request-{n:04d}.json").write_bytes(body)
                append_jsonl(log, {"t_ns": received, "n": n, "path": self.path, "kind": "rate-limited", "user_text": user_text})
                refusal = b'{"error":{"message":"rate limited"}}'
                self.send_response(429)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(refusal)))
                self.send_header("Retry-After", "8")
                self.send_header("X-Request-Id", f"fixture-request-{n}")
                self.send_header("Connection", "close")
                self.end_headers()
                self.wfile.write(refusal)
                self.close_connection = True
                return
            if tool_results:
                kind = "tool-summary"
                summary = fixture_summary(user_text, n, len(tool_results), run.meta.get("answers", "echo"))
                if user_text and ("show environment" in user_text or "start a child" in user_text):
                    # Say what Bash printed, so the conversation shows it.
                    printed = [r.get("output", "").partition("stdout tail:\n")[2].rstrip("\n") for r in tool_results]
                    summary += "\n\nBash printed:\n" + "\n".join(printed)
                payload = fixture.sse_answer(f"r{n}", f"rs{n}", f"rm{n}", summary)[0]
            elif user_text and "tool demonstration" in user_text:
                kind = "tool-calls"
                payload = fixture.sse_tool_calls(f"r{n}", [
                    bash(f"c{n}a", "ls", "List project files"),
                    bash(f"c{n}b", "exit 127", "Fail with exit 127"),
                    bash(f"c{n}c", "printf 'usage: example\\nunknown option --help\\n' >&2; exit 1", "Fail with an excerpt")])
            elif user_text and "parallel bash" in user_text:
                kind = "parallel-bash"
                payload = fixture.sse_tool_calls(f"r{n}", [
                    bash(f"c{n}a", "sleep 12; echo built", "Build the docs"),
                    bash(f"c{n}b", "sleep 20; echo tested", "Run the slow tests")])
            elif user_text and "show environment" in user_text:
                kind = "show-environment"
                payload = fixture.sse_tool_calls(f"r{n}", [bash(f"c{n}",
                    "printf 'CLIENT_MARK=%s\\n' \"${CLIENT_MARK-unset}\"; printf 'HOST_SECRET=%s\\n' \"${HOST_SECRET-unset}\"; command -v brew || echo 'brew: not found'; "
                    "printf 'PATH=%s\\n' \"$PATH\"", "Show the environment")])
            elif user_text and (relay := re.search(r"relay to ([0-9a-z]{6})", user_text)):
                kind = "relay"
                payload = fixture.sse_tool_calls(f"r{n}", [bash(f"c{n}",
                    f"printf 'show environment' | rui session send --to {relay.group(1)}", "Relay to a peer")])
            elif user_text and "start a child" in user_text:
                kind = "start-child"
                payload = fixture.sse_tool_calls(f"r{n}", [bash(f"c{n}",
                    "printf 'show environment' | rui session start --label child --permission-mode bypass", "Start a child Session")])
            elif user_text and "long bash" in user_text:
                kind = "long-bash"
                payload = fixture.sse_tool_calls(f"r{n}", [bash(f"c{n}", "sleep 8; echo slept", "Sleep eight seconds")])
            elif user_text and "invalid output" in user_text:
                # A stream the provider adapter cannot read: the Turn fails.
                kind = "invalid-output"
                payload = b"data: {not json\n\n"
            elif user_text and "consent check" in user_text:
                kind = "consent-call"
                command = "set -eu\n" + "\n".join(f"printf 'step {k:02d}\\n' >> progress.log" for k in range(1, 31)) + "\nwc -l progress.log"
                payload = fixture.sse_tool_calls(f"r{n}", [bash(f"c{n}", command, "Record thirty progress steps")])
            else:
                kind = "echo"
                payload = fixture.sse_answer(f"r{n}", f"rs{n}", f"rm{n}",
                    fixture_answer(user_text, n, run.meta.get("answers", "echo")))[0]
                if user_text and "slow" in user_text:
                    # About 10 s in flight, whatever the answer's length.
                    kind, chunk_delay = "echo-slow", 10.0 / -(-len(payload) // 64)
            (bodies / f"request-{n:04d}.json").write_bytes(body)
            append_jsonl(log, {"t_ns": received, "n": n, "path": self.path, "kind": kind,
                               "user_text": user_text, "tool_results": len(tool_results), "input_items": len(items),
                               "body_sha256": hashlib.sha256(body).hexdigest(),
                               "headers": {k: v for k, v in self.headers.items() if k.lower() not in ("authorization", "cookie")}})
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("X-Request-Id", f"fixture-request-{n}")
            self.send_header("OpenAI-Model", "model-a-served")
            self.send_header("Connection", "close")
            self.end_headers()
            step = 64 if chunk_delay else len(payload)
            for offset in range(0, len(payload), step):
                if chunk_delay:
                    time.sleep(chunk_delay)
                try:
                    self.wfile.write(payload[offset:offset + step])
                    self.wfile.flush()
                except OSError:
                    break
            append_jsonl(log, {"t_ns": now_ns(), "n": n, "event": "response-finished"})
            self.close_connection = True

        def log_message(self, *_):
            pass

    # Rui's client speaks HTTP/2; the integration fixture's server answers both.
    from host_process import TestHTTPServer
    server = TestHTTPServer(("127.0.0.1", 0), Handler)
    atomic_write(run.scratch / "fixture.port", str(server.server_port))
    server.serve_forever()


# ---------------------------------------------------------------- tap: the PTY proxy around Rui


def stty_masked(saved):
    """stty -g fields with kernel-owned lflag bits (PENDIN, FLUSHO) cleared."""
    import termios
    if saved is None:
        return None
    mask = getattr(termios, "PENDIN", 0) | getattr(termios, "FLUSHO", 0)
    fields = []
    for field in saved.split(":"):
        if field.startswith("lflag="):
            field = f"lflag={int(field[6:], 16) & ~mask:x}"
        fields.append(field)
    return ":".join(fields)


def tap_main(args):
    """Run argv in an inner PTY; log every received input byte and output byte.

    mode=terminal: input is this process's stdin (a tmux pane or a real terminal).
    mode=fifo: input is TERMDIR/in.fifo (headless PTY driven by `verify-rui send`).
    Committed frames (synchronized-update boundaries) are decoded with the
    repository's ScreenCapture and written to frames.jsonl / committed.txt.
    """
    import fcntl
    import struct
    import termios
    import tty
    source = pathlib.Path(args.source)
    head = subprocess.run(["git", "-C", str(source), "rev-parse", "HEAD"], capture_output=True, text=True, check=True)
    build = load_build(head.stdout.strip())
    require_screen(build)
    term = pathlib.Path(args.term_dir)
    term.mkdir(parents=True, exist_ok=True)
    sys.path.insert(0, str(source / "tests/integration"))
    try:
        os.environ["RUI_TEST_GHOSTTY_VT"] = build["screen_library"]
        from terminal_screen import ScreenCapture
    except Exception as error:  # no observer library: still record bytes
        ScreenCapture = None
        append_jsonl(term / "tap-events.jsonl", {"t_ns": now_ns(), "event": "screen-capture-unavailable", "error": repr(error)})
    terminal = args.mode == "terminal"
    if terminal:
        size = struct.unpack("HHHH", fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8))
        rows, columns = size[0] or 24, size[1] or 80
        outer_attrs = termios.tcgetattr(0)
    else:
        columns, rows = (int(v) for v in args.size.split("x"))
        outer_attrs = None
        fifo = term / "in.fifo"
        if not fifo.exists():
            os.mkfifo(fifo, 0o600)
    master, slave = os.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", rows, columns, 0, 0))
    if outer_attrs is not None:
        termios.tcsetattr(slave, termios.TCSANOW, outer_attrs)
    attrs_before = termios.tcgetattr(slave)
    pid = os.fork()
    if pid == 0:
        os.close(master)
        os.setsid()
        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        for fd in (0, 1, 2):
            os.dup2(slave, fd)
        if slave > 2:
            os.close(slave)
        os.chdir(args.cwd)
        # stty -g on this same tty before and after the target: the inner tty is
        # revoked for the tap once its session leader exits (macOS), so the
        # wrapper shell, not the tap, observes the restored termios.
        wrapper = ('stty -g > "$1/stty-before.txt"; shift; "$@"; rc=$?; '
                   'stty -g > "$VERIFY_RUI_TERM/stty-after.txt"; printf "%s\\n" "$rc" > "$VERIFY_RUI_TERM/target-rc.txt"; exit "$rc"')
        loaded = json.loads(pathlib.Path(args.env[1:]).read_text()) if args.env.startswith("@") else json.loads(args.env)
        env = {**loaded, "VERIFY_RUI_TERM": str(term)}
        os.execve("/bin/sh", ["/bin/sh", "-c", wrapper, "verify-rui-wrapper", str(term), *args.argv], env)
    meta = {"t_start_ns": now_ns(), "wall": wall(), "tap_pid": os.getpid(), "child_pid": pid,
            "argv": args.argv, "mode": args.mode, "columns": columns, "rows": rows,
            "child_lstart": (process_start(pid) or [None])[0], "attrs_before": repr(attrs_before)}
    atomic_write(term / "meta.json", json.dumps(meta, indent=1))
    # Headless, the observer is the terminal and answers queries; inside a
    # terminal, that terminal answers them.
    reply = None if terminal else functools.partial(os.write, master)
    capture = ScreenCapture(columns, rows, reply=reply) if ScreenCapture else None
    frames = open(term / "frames.jsonl", "a")
    inputs = open(term / "input.jsonl", "a")
    outputs = open(term / "output.jsonl", "a")
    raw_out = open(term / "output.bin", "ab")
    raw_in = open(term / "input.bin", "ab")
    offset = {"out": 0, "in": 0}

    def commit(screen, x, y):
        record = {"t_ns": now_ns(), "gen": capture.generation, "cursor": [x, y], "out_offset": offset["out"], "screen": screen}
        frames.write(json.dumps(record, ensure_ascii=False) + "\n")
        frames.flush()
        atomic_write(term / "committed.txt", f"gen={capture.generation} cursor={x},{y}\n{screen}\n")

    if capture:
        capture.listener = commit
    if terminal:
        tty.setraw(0)
        in_fd = 0
    else:
        in_fd = os.open(term / "in.fifo", os.O_RDWR | os.O_NONBLOCK)
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)

    def on_signal(signum, _frame):
        try:
            os.write(wake_w, bytes([signum]))
        except OSError:
            pass

    signal.signal(signal.SIGCHLD, on_signal)
    signal.signal(signal.SIGWINCH, on_signal)
    signal.signal(signal.SIGHUP, on_signal)
    status = None
    capture_ok = capture is not None

    def feed_output(chunk):
        nonlocal capture_ok
        raw_out.write(chunk)
        raw_out.flush()
        outputs.write(json.dumps({"t_ns": now_ns(), "offset": offset["out"], "n": len(chunk)}) + "\n")
        outputs.flush()
        offset["out"] += len(chunk)
        if terminal:
            view = memoryview(chunk)
            while view:
                try:
                    written = os.write(1, view)
                    view = view[written:]
                except BlockingIOError:
                    select.select([], [1], [], 1)
        if capture_ok:
            try:
                capture.feed(chunk)
            except Exception as error:
                capture_ok = False
                append_jsonl(term / "tap-events.jsonl", {"t_ns": now_ns(), "event": "screen-capture-failed", "error": repr(error)})
        if not capture_ok or not capture:
            return
        try:
            atomic_write(term / "display.txt", "\n".join(line.rstrip() for line in capture.screen.display) + "\n")
        except Exception:
            pass

    while status is None:
        ready = select.select([master, in_fd, wake_r], [], [], 1.0)[0]
        if wake_r in ready:
            for signum in os.read(wake_r, 64):
                if signum == signal.SIGWINCH and terminal:
                    size = struct.unpack("HHHH", fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8))
                    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", size[0], size[1], 0, 0))
                    if capture:
                        capture.resize(size[1], size[0])
                    append_jsonl(term / "tap-events.jsonl", {"t_ns": now_ns(), "event": "resize", "rows": size[0], "columns": size[1]})
                elif signum == signal.SIGHUP:
                    append_jsonl(term / "tap-events.jsonl", {"t_ns": now_ns(), "event": "sighup"})
            done, code = os.waitpid(pid, os.WNOHANG)
            if done:
                status = code
        if master in ready:
            try:
                chunk = os.read(master, 65536)
            except OSError:
                chunk = b""
            if chunk:
                feed_output(chunk)
        if in_fd in ready and status is None:
            try:
                chunk = os.read(in_fd, 65536)
            except (BlockingIOError, OSError):
                chunk = b""
            if chunk:
                t = now_ns()
                raw_in.write(chunk)
                raw_in.flush()
                inputs.write(json.dumps({"t_ns": t, "offset": offset["in"], "n": len(chunk), "hex": chunk.hex(),
                                         "text": chunk.decode("utf-8", "backslashreplace")}, ensure_ascii=False) + "\n")
                inputs.flush()
                offset["in"] += len(chunk)
                os.write(master, chunk)
            elif terminal:
                append_jsonl(term / "tap-events.jsonl", {"t_ns": now_ns(), "event": "stdin-eof"})
                in_fd = os.open("/dev/null", os.O_RDONLY)
        if status is None:
            done, code = os.waitpid(pid, os.WNOHANG)
            if done:
                status = code
    os.set_blocking(master, False)
    while True:
        try:
            chunk = os.read(master, 65536)
        except OSError:
            break
        if not chunk:
            break
        feed_output(chunk)
    before_path, after_path = term / "stty-before.txt", term / "stty-after.txt"
    stty_before = before_path.read_text().strip() if before_path.exists() else None
    stty_after = after_path.read_text().strip() if after_path.exists() else None
    target_rc = (term / "target-rc.txt").read_text().strip() if (term / "target-rc.txt").exists() else None
    exit_record = {"t_ns": now_ns(), "wall": wall(), "raw_status": status,
                   "wrapper_exit_code": os.waitstatus_to_exitcode(status),
                   "target_rc": target_rc,
                   "termios_restored": stty_before is not None and stty_masked(stty_before) == stty_masked(stty_after),
                   "termios_mask": "lflag PENDIN|FLUSHO (kernel-owned; same mask as terminal_restoration_integration.py)",
                   "stty_before": stty_before, "stty_after": stty_after,
                   "output_tail_hex": (term / "output.bin").read_bytes()[-256:].hex(),
                   "alternate_screen_active_at_exit": capture.alternate if capture else None,
                   "last_committed": capture.completed if capture else None,
                   "main_screen_plain_tail": capture.plain[-2000:] if capture else None}
    atomic_write(term / "exit.json", json.dumps(exit_record, indent=1, ensure_ascii=False))
    if terminal:
        termios.tcsetattr(0, termios.TCSADRAIN, outer_attrs)
        if args.hold:
            os.write(1, b"\r\n[verify-rui: Rui exited; press Enter to close]\r\n")
            os.read(0, 1)
    sys.exit(0)


# ---------------------------------------------------------------- new run


def launch_host(run):
    """Start this run's Host from the options saved at `new`; return its ready status."""
    options = run.meta["host_options"]
    host_argv = [str(run.rui), "host", "serve", "--store", str(run.store), "--active-capacity", str(options["active_capacity"]),
                 "--provider-endpoint", run.meta["fixture_url"], "--test-retry-waits-ms", "50,100,150"]
    host_env = run.env()
    for assignment in options["host_setenv"]:
        key, _, value = assignment.partition("=")
        host_env[key] = value
    host = subprocess.Popen(host_argv, env=host_env, cwd=run.project, stdin=subprocess.DEVNULL,
                            stdout=open(run.evidence / "host.stdout.log", "a"), stderr=open(run.evidence / "host.log", "a"),
                            start_new_session=True)
    run.own("host", host.pid, argv=host_argv)
    deadline = time.monotonic() + 30
    while True:
        status = run.rui_cmd("host", "status", "--store", run.store, log=False)
        if status.returncode == 0 and "unavailable" not in status.stdout + status.stderr:
            return status
        if host.poll() is not None or time.monotonic() > deadline:
            die(f"host did not become ready (rc={host.poll()}); see {run.evidence / 'host.log'}")
        time.sleep(0.1)


def cmd_restart_host(args):
    """Stop the run's Host and start a fresh one on the same Store, fixture and options."""
    run = Run(args.run)
    old = [r for r in run.owned() if r["kind"] == "host" and process_start(r["pid"])
           and process_start(r["pid"])[0] == r["lstart"]]
    # A Host that is already stopped is simply started again.
    stop = run.rui_cmd("host", "pause", "--store", run.store) if old else None
    if stop and stop.returncode != 0:
        die(f"host pause failed: {stop.stderr}")
    deadline = time.monotonic() + 15
    while any(process_start(r["pid"]) and process_start(r["pid"])[0] == r["lstart"] for r in old):
        if time.monotonic() > deadline:
            die("old Host did not exit after host pause")
        time.sleep(0.1)
    status = launch_host(run)
    print(json.dumps({"stopped": [r["pid"] for r in old], "instance": json.loads(status.stdout).get("instance")}))


def cmd_new(args):
    build = load_build(args.sha)
    run_id = time.strftime("%Y%m%dT%H%M%S") + f"-{args.sha[:7]}-{os.getpid()}"
    root = CACHE / "runs" / run_id
    scratch = SCRATCH_PARENT / f"vr.{os.getpid()}.{int(time.time()) % 100000}"
    for path in (root / "evidence", scratch / "home", scratch / "project", scratch / "tmp", scratch / "tmux"):
        path.mkdir(parents=True, exist_ok=False if path == root / "evidence" else True)
    os.chmod(scratch, 0o700)
    os.chmod(scratch / "home", 0o700)
    os.chmod(scratch / "tmux", 0o700)
    scratch = scratch.resolve()
    (scratch / "project/README.md").write_text("verify-rui project\n")
    (scratch / "project/src").mkdir()
    meta = {"id": run_id, "sha": args.sha, "tree": build["tree"], "binary": build["binary"],
            "binary_sha256": build["files_sha256"]["rui"], "source": build["source"],
            "scratch": str(scratch), "home": str(scratch / "home"), "store": str(scratch / "store"),
            "project": str(scratch / "project"), "created": wall(), "label": args.label,
            "helper_sha256": sha256(HERE), "answers": getattr(args, "answers", "echo")}
    (root / "run.json").write_text(json.dumps(meta, indent=1) + "\n")
    run = Run(root)
    (run.home / ".config/rui").mkdir(parents=True, mode=0o700)
    sys.argv = [sys.argv[0], str(run.rui)]
    sys.path.insert(0, str(pathlib.Path(run.meta["source"]) / "tests/integration"))
    import codex_integration as codex_fixture
    codex_fixture.credentials(run.home / ".config/rui/codex.json")
    python = sys.executable
    fixture = subprocess.Popen([python, str(HERE), "_fixture", str(root)], stdout=open(run.evidence / "fixture.log", "w"),
                               stderr=subprocess.STDOUT, start_new_session=True, env={**run.env(), "PATH": os.environ["PATH"]})
    run.own("fixture", fixture.pid)
    port_file = scratch / "fixture.port"
    deadline = time.monotonic() + 15
    while not port_file.exists():
        if fixture.poll() is not None or time.monotonic() > deadline:
            die(f"fixture did not start; see {run.evidence / 'fixture.log'}")
        time.sleep(0.05)
    port = int(port_file.read_text())
    meta["fixture_url"] = f"http://127.0.0.1:{port}/responses"
    (root / "run.json").write_text(json.dumps(meta, indent=1) + "\n")
    run = Run(root)
    meta["host_options"] = {"active_capacity": args.active_capacity, "host_setenv": args.host_setenv}
    (root / "run.json").write_text(json.dumps(meta, indent=1) + "\n")
    run = Run(root)
    status = launch_host(run)
    meta["host_instance"] = json.loads(status.stdout).get("instance")
    (root / "run.json").write_text(json.dumps(meta, indent=1) + "\n")
    # Sessions have Host-allocated IDs: start each one labelled with its name
    # and keep the ID for --session NAME.
    meta["sessions"] = {}
    for session, mode in () if args.no_sessions else (("demo", "bypass"), ("approve", "ask")):
        result = run.rui_cmd("session", "start", "--store", run.store, "--workspace", run.project,
                             "--provider", "codex", "--model", "gpt-5.5", "--permission-mode", mode, "--label", session,
                             input=f"verify-rui opened {session}")
        if result.returncode != 0:
            die(f"start {session} failed: {result.stderr}")
        meta["sessions"][session] = json.loads(result.stdout)["answer"]["session"]
        handle = re.search(r"request: (\S+)", result.stderr)
        if handle:
            wait_request(run, handle.group(1))
    (root / "run.json").write_text(json.dumps(meta, indent=1) + "\n")
    run.meta = meta
    for index in range(args.seed):
        text = f"Seed history message {index + 1}: " + "lorem ipsum dolor sit amet " * 12
        result = run.rui_cmd("session", "send", "--store", run.store, "--to", run.sid("demo"), input=text)
        if result.returncode != 0:
            die(f"seed send failed: {result.stderr}")
        handle = re.search(r"request: (\S+)", result.stderr)
        wait_request(run, handle.group(1))
    print(root)


def macos_version():
    """The macOS release, or "" on another system."""
    if shutil.which("sw_vers") is None:
        return ""
    return subprocess.run(["sw_vers", "-productVersion"], capture_output=True, text=True).stdout.strip()


def wait_request(run, handle, timeout=30):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        result = run.rui_cmd("request", "inspect", "--store", run.store, "--key", handle, log=False)
        if result.returncode == 0 and '"completed"' in result.stdout:
            return json.loads(result.stdout)
        time.sleep(0.2)
    die(f"request {handle} did not complete")


# ---------------------------------------------------------------- doctor


def cmd_doctor(args):
    run = Run(args.run)
    checks = []

    def check(name, ok, detail=""):
        checks.append({"check": name, "ok": bool(ok), "detail": detail})

    build = load_build(run.meta["sha"])
    check("binary matches pinned build", run.rui.exists() and sha256(run.rui) == build["files_sha256"]["rui"] == run.meta["binary_sha256"],
          f"{run.rui} sha256={sha256(run.rui) if run.rui.exists() else 'missing'}")
    head = subprocess.run(["git", "-C", run.meta["source"], "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    check("source is pinned SHA", head == run.meta["sha"], f"{run.meta['source']} HEAD={head}")
    if args.expect_sha:
        check("run SHA is the expected head", run.meta["sha"] == args.expect_sha, f"run={run.meta['sha']} expected={args.expect_sha}")
    default_store = pathlib.Path.home() / ".local/share/rui/store"
    check("synthetic HOME and Store", str(run.home).startswith(str(run.scratch)) and str(run.store).startswith(str(run.scratch))
          and run.store != default_store, f"HOME={run.home} store={run.store}")
    for record in run.owned():
        if record["kind"] in ("fixture", "host"):
            current = process_start(record["pid"])
            check(f"owned {record['kind']} pid {record['pid']} alive and unchanged",
                  current is not None and current[0] == record["lstart"], f"now={current}")
    try:
        import urllib.request
        reply = json.loads(urllib.request.urlopen(run.meta["fixture_url"].replace("/responses", "/health"), timeout=3).read())
        check("fixture answers with this run id", reply.get("verify_rui_fixture") == run.meta["id"], json.dumps(reply))
    except Exception as error:
        check("fixture answers with this run id", False, repr(error))
    status = run.rui_cmd("host", "status", "--store", run.store, log=False)
    host_pid = next((r["pid"] for r in run.owned() if r["kind"] == "host"), None)
    text = status.stdout + status.stderr
    check("Host ready on this Store", status.returncode == 0 and "unavailable" not in text, text.strip()[:600])
    try:
        instance = json.loads(status.stdout).get("instance")
    except ValueError:
        instance = None
    check("Host instance is the one this run launched", instance and instance == run.meta.get("host_instance"),
          f"now={instance} launched={run.meta.get('host_instance')}")
    held = subprocess.run(["lsof", "-a", "-p", str(host_pid), "-Fn"], capture_output=True, text=True).stdout if host_pid else ""
    check("owned Host process holds this Store open", any(line[1:].startswith(str(run.store)) for line in held.splitlines()),
          f"pid={host_pid}")
    sessions = run.rui_cmd("session", "list", "--store", run.store, "--all", log=False)
    check("configured Sessions present", sessions.returncode == 0 and all(f'"{run.sid(name)}"' in sessions.stdout for name in ("demo", "approve")),
          sessions.stdout.strip()[:300] or sessions.stderr.strip()[:300])
    if run.sock.exists():
        server = run.tmux("display-message", "-p", "#{pid} #{socket_path}", check=False)
        check("tmux server is this run's private socket", server.returncode == 0 and str(run.sock) in server.stdout, server.stdout.strip() or server.stderr.strip())
    trusted = accessibility()
    checks.append({"check": "macOS Accessibility (synthetic GUI input) [informational]", "ok": None, "detail": trusted})
    ok = all(c["ok"] for c in checks if c["ok"] is not None)
    report = {"verdict": "PASS" if ok else "ISSUES", "run": str(run.root), "sha": run.meta["sha"], "t_ns": now_ns(), "wall": wall(), "checks": checks}
    append_jsonl(run.evidence / "doctor.jsonl", report)
    for c in checks:
        mark = "ok " if c["ok"] else ("-- " if c["ok"] is None else "BAD")
        print(f"[{mark}] {c['check']}: {c['detail']}")
    print(report["verdict"])
    sys.exit(0 if ok else 1)


def accessibility():
    try:
        import ctypes
        services = ctypes.cdll.LoadLibrary("/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices")
        services.AXIsProcessTrusted.restype = ctypes.c_bool
        graphics = ctypes.cdll.LoadLibrary("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
        graphics.CGPreflightScreenCaptureAccess.restype = ctypes.c_bool
        return {"AXIsProcessTrusted": services.AXIsProcessTrusted(), "CGPreflightScreenCaptureAccess": graphics.CGPreflightScreenCaptureAccess()}
    except Exception as error:
        return {"error": repr(error)}


# ---------------------------------------------------------------- terminals


def session_argv(run, session):
    if session == "overview":
        # Bare `rui`, with this run's Store: the overview of every Session.
        return [str(run.rui), "--store", str(run.store)]
    return [str(run.rui), "session", "resume", "--store", str(run.store), run.sid(session)]


def cmd_term(args):
    run = Run(args.run)
    if not args.no_tap:
        require_screen(load_build(run.meta["sha"]))
    name = args.name
    term = run.term_dir(name)
    if term.exists():
        die(f"terminal {name} already exists in this run; pick a new name")
    term.mkdir(parents=True)
    argv = session_argv(run, args.session) if not args.argv else args.argv
    columns, rows = (int(v) for v in args.size.split("x"))
    python = sys.executable
    child_env = run.env(COLORTERM="truecolor")
    for assignment in args.setenv:
        key, _, value = assignment.partition("=")
        child_env[key] = value.replace("{PATH}", child_env["PATH"]) if key == "PATH" else value
    tap = [python, str(HERE), "_tap", str(term), "--source", run.meta["source"], "--cwd", str(run.project),
           "--env", json.dumps(child_env), "--size", args.size]
    record = {"name": name, "surface": args.surface, "session": args.session, "argv": argv, "size": args.size,
              "tapped": not args.no_tap, "setenv": args.setenv, "t_ns": now_ns(), "wall": wall()}
    if args.surface == "pty":
        if args.no_tap:
            die("--no-tap applies to tmux surfaces")
        process = subprocess.Popen([*tap, "--mode", "fifo", "--", *argv], stdin=subprocess.DEVNULL,
                                   stdout=open(term / "tap.log", "w"), stderr=subprocess.STDOUT, start_new_session=True)
        run.own("tap", process.pid, term=name)
        record["tap_pid"] = process.pid
    else:
        if not run.sock.exists():
            first = True
        else:
            first = run.tmux("has-session", "-t", "=verify-rui", check=False).returncode != 0
        pane_cmd = shlex.join([*tap, "--mode", "terminal", "--", *argv]) if not args.no_tap else \
            "exec env -i " + " ".join(shlex.quote(f"{k}={v}") for k, v in child_env.items()) + " " + shlex.join(argv)
        if first:
            run.tmux("-f", "/dev/null", "new-session", "-d", "-s", "verify-rui", "-n", name, "-x", columns, "-y", rows,
                     "-c", run.project, pane_cmd)
            run.tmux("set-option", "-g", "remain-on-exit", "on")
            run.tmux("set-option", "-g", "default-size", f"{columns}x{rows}")
            run.tmux("set-option", "-g", "window-size", "manual" if args.surface == "tmux-detached" else "latest")
            server_pid = int(run.tmux("display-message", "-p", "#{pid}").stdout.strip())
            run.own("tmux-server", server_pid, socket=str(run.sock))
        else:
            # tmux 3.4 exits if it makes a window while window-size is manual.
            size_mode = run.tmux("show-options", "-gv", "window-size").stdout.strip()
            run.tmux("set-option", "-g", "window-size", "latest")
            run.tmux("new-window", "-d", "-t", "verify-rui", "-n", name, "-c", run.project, pane_cmd)
            run.tmux("set-option", "-g", "window-size", size_mode)
        target = f"=verify-rui:={name}"
        run.tmux("resize-window", "-t", target, "-x", columns, "-y", rows, check=False)
        pane = run.tmux("display-message", "-p", "-t", target, "#{pane_id} #{pane_pid} #{pane_tty}").stdout.split()
        record.update({"tmux_target": target, "pane_id": pane[0], "pane_pid": int(pane[1]), "pane_tty": pane[2]})
        if args.surface == "tmux-attached":
            record["client"] = attach_client(run, name, args.size)
    atomic_write(term / "term.json", json.dumps(record, indent=1))
    if not args.no_tap:
        wait_meta(term)
    print(json.dumps(record))


def wait_meta(term, timeout=10):
    deadline = time.monotonic() + timeout
    while not (term / "meta.json").exists():
        if time.monotonic() > deadline:
            die(f"tap did not start for {term}")
        time.sleep(0.05)


def attach_client(run, name, size):
    """An owned tmux client attached through its own recorded PTY (tap in fifo mode)."""
    client = f"{name}.client"
    term = run.term_dir(client)
    term.mkdir(parents=True)
    python = sys.executable
    argv = [shutil.which("tmux") or "/opt/homebrew/bin/tmux", "-S", str(run.sock), "attach-session", "-t", f"=verify-rui:={name}"]
    process = subprocess.Popen([python, str(HERE), "_tap", str(term), "--source", run.meta["source"], "--cwd", str(run.project),
                                "--env", json.dumps(run.env()), "--size", size, "--mode", "fifo", "--", *argv],
                               stdin=subprocess.DEVNULL, stdout=open(term / "tap.log", "w"), stderr=subprocess.STDOUT,
                               start_new_session=True)
    run.own("tap", process.pid, term=client)
    wait_meta(term)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        clients = run.tmux("list-clients", "-F", "#{client_pid} #{client_tty} #{session_name}", check=False).stdout.strip()
        if clients:
            break
        time.sleep(0.1)
    atomic_write(term / "term.json", json.dumps({"name": client, "surface": "tmux-client", "attached_to": name, "argv": argv,
                                                  "tap_pid": process.pid, "clients": clients}, indent=1))
    return {"term": client, "tap_pid": process.pid, "clients": clients}


def term_record(run, name):
    path = run.term_dir(name) / "term.json"
    if not path.exists():
        die(f"no terminal {name} in {run.root}")
    return json.loads(path.read_text())


KEYS = {"Enter": b"\r", "Esc": b"\x1b", "C-c": b"\x03", "C-g": b"\x07", "C-r": b"\x12", "C-x": b"\x18", "BSpace": b"\x7f",
        "PgUp": b"\x1b[5~", "PgDn": b"\x1b[6~", "Up": b"\x1b[A", "Down": b"\x1b[B", "Right": b"\x1b[C", "Left": b"\x1b[D", "End": b"\x1b[F", "Home": b"\x1b[H",
        "Tab": b"\t", "S-PgUp": b"\x1b[5;2~",
        # Unsolicited mouse reports: Rui never enables mouse tracking (it uses ?1007
        # alternate scroll), so a physical wheel arrives as Up/Down, not as these.
        "SGRWheelUp": b"\x1b[<64;10;10M", "SGRWheelDown": b"\x1b[<65;10;10M"}


def cmd_send(args):
    """Inject input and log exactly what was injected, by which mechanism, when."""
    run = Run(args.run)
    record = term_record(run, args.name)
    if args.text is not None:
        payload, tmux_args = args.text.encode(), ["-l", args.text]
    elif args.hex is not None:
        payload, tmux_args = bytes.fromhex(args.hex), None
    else:
        # Exact bytes even through tmux: tmux key names differ (Esc is literal text there).
        payload = b"".join(KEYS[k] for k in args.keys)
        tmux_args = None
    via = args.via or ("fifo" if record["surface"] in ("pty", "tmux-client") else "tmux")
    entry = {"t_ns": now_ns(), "wall": wall(), "term": args.name, "via": via, "payload_hex": payload.hex(),
             "payload_text": payload.decode("utf-8", "backslashreplace")}
    if via == "fifo":
        fd = os.open(run.term_dir(args.name) / "in.fifo", os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, payload)
        os.close(fd)
    elif via == "client":
        client = record.get("client", {}).get("term")
        if not client:
            die("--via client needs a tmux-attached terminal")
        entry["client_term"] = client
        fd = os.open(run.term_dir(client) / "in.fifo", os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, payload)
        os.close(fd)
    else:
        if tmux_args is None:
            tmux_args = ["-H", *[f"{b:02x}" for b in payload]]
        argv = ["send-keys", "-t", record["tmux_target"], *tmux_args]
        entry["tmux_argv"] = argv
        run.tmux(*argv)
    entry["t_end_ns"] = now_ns()
    append_jsonl(run.evidence / "injections.jsonl", entry)
    print(json.dumps(entry, ensure_ascii=False))


def cmd_signal(args):
    run = Run(args.run)
    meta = json.loads((run.term_dir(args.name) / "meta.json").read_text())
    wrapper = meta["child_pid"]
    current = process_start(wrapper)
    if current is None or current[0] != meta["child_lstart"]:
        die(f"wrapper {wrapper} is not the process this terminal started (now {current})")
    children = subprocess.run(["pgrep", "-P", str(wrapper)], capture_output=True, text=True).stdout.split()
    if len(children) != 1:
        die(f"expected exactly one Rui child of wrapper {wrapper}, found {children}")
    pid = int(children[0])
    command = process_start(pid)
    if command is None or not command[1].startswith(json.loads((run.term_dir(args.name) / "term.json").read_text())["argv"][0]):
        die(f"child {pid} is not this terminal's Rui ({command})")
    signum = getattr(signal, f"SIG{args.signal}")
    entry = {"t_ns": now_ns(), "wall": wall(), "term": args.name, "via": "kill", "pid": pid, "signal": args.signal}
    os.kill(pid, signum)
    append_jsonl(run.evidence / "injections.jsonl", entry)
    print(json.dumps(entry))


def frames(run, name):
    return read_jsonl(run.term_dir(name) / "frames.jsonl")


def composer_ready(screen, cursor):
    lines = screen.split("\n")
    x, y = cursor
    if "Opening…" in screen or y >= len(lines):
        return False
    line = lines[y]
    # The overview's composer is indented one cell, and is ASCII under LANG=C.
    return x >= 2 and (line in ("›", " ›", " >") or line.startswith(("› ", " › ", " > ")))


def cmd_wait(args):
    """Wait for a committed frame (after --after GEN) that contains MARKER."""
    run = Run(args.run)
    require_screen(load_build(run.meta["sha"]))
    deadline = time.monotonic() + args.timeout
    after = args.after
    if after is None:
        after = -1
    while time.monotonic() < deadline:
        for frame in frames(run, args.name):
            if frame["gen"] <= after:
                continue
            if args.marker in frame["screen"] and (not args.composer or composer_ready(frame["screen"], frame["cursor"])) \
                    and (args.absent is None or args.absent not in frame["screen"]):
                print(json.dumps({"gen": frame["gen"], "t_ns": frame["t_ns"], "cursor": frame["cursor"]}))
                print(frame["screen"])
                return
        exit_path = run.term_dir(args.name) / "exit.json"
        if exit_path.exists() and not args.allow_exit:
            die(f"terminal exited before marker {args.marker!r}: {exit_path}", 1)
        time.sleep(0.05)
    last = frames(run, args.name)
    print(last[-1]["screen"] if last else "(no committed frame)")
    die(f"timeout waiting for {args.marker!r} after gen {after}", 1)


def cmd_screen(args):
    """Print and save the current committed frame (and tmux's view for tmux panes)."""
    run = Run(args.run)
    term = run.term_dir(args.name)
    label = args.label or f"t{now_ns()}"
    shots = term / "shots"
    shots.mkdir(exist_ok=True)
    committed = (term / "committed.txt").read_text() if (term / "committed.txt").exists() else "(no committed frame)\n"
    (shots / f"{label}.committed.txt").write_text(committed)
    print(committed, end="")
    record = term_record(run, args.name)
    if record.get("tmux_target"):
        pane = run.tmux("capture-pane", "-p", "-e", "-t", record["tmux_target"], check=False).stdout
        (shots / f"{label}.tmux.ansi").write_text(pane)
        plain = run.tmux("capture-pane", "-p", "-t", record["tmux_target"], check=False).stdout
        (shots / f"{label}.tmux.txt").write_text(plain)
        flags = run.tmux("display-message", "-p", "-t", record["tmux_target"],
                         "alternate_on=#{alternate_on} cursor_flag=#{cursor_flag} mouse_any_flag=#{mouse_any_flag} "
                         "mouse_sgr_flag=#{mouse_sgr_flag} keypad_cursor_flag=#{keypad_cursor_flag} pane_dead=#{pane_dead} "
                         "pane_dead_status=#{pane_dead_status} cursor=#{cursor_x},#{cursor_y} size=#{pane_width}x#{pane_height} "
                         "session_attached=#{session_attached}", check=False).stdout
        (shots / f"{label}.tmux-flags.txt").write_text(flags)
        print(f"--- tmux view ({label})\n{plain}--- tmux flags: {flags}", end="")
    append_jsonl(run.evidence / "shots.jsonl", {"t_ns": now_ns(), "term": args.name, "label": label})


def cmd_rui(args):
    """Any one-shot Rui command, with this run's HOME and an enforced --store."""
    run = Run(args.run)
    argv = list(args.argv)
    if argv and argv[0] == "--":
        argv = argv[1:]
    if "--store" not in argv and argv[:2] != ["request", "list"]:
        die("pass --store explicitly; this run's Store is " + str(run.store))
    result = run.rui_cmd(*argv)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    sys.exit(result.returncode)


# ---------------------------------------------------------------- evidence and correlation


def cmd_evidence(args):
    """Export Store/capture facts and correlate injections, input bytes, captures and provider requests."""
    run = Run(args.run)
    out = run.evidence / "export"
    out.mkdir(exist_ok=True)
    exports = {}
    for name, argv in (("request-list", ["request", "list"]),
                       ("sessions", ["session", "list", "--store", run.store, "--all"]),
                       ("demo-inspect", ["session", "inspect", "--store", run.store, run.sid("demo"), "--profile", "full"]),
                       ("approve-inspect", ["session", "inspect", "--store", run.store, run.sid("approve"), "--profile", "full"])):
        result = run.rui_cmd(*argv)
        (out / f"{name}.json").write_text(result.stdout)
        if result.stderr:
            (out / f"{name}.stderr").write_text(result.stderr)
        exports[name] = result.returncode
    captures = []
    try:
        listed = json.loads((out / "request-list.json").read_text() or "[]")
        entries = listed if isinstance(listed, list) else listed.get("requests", listed.get("captures", []))
        for entry in entries:
            key = entry.get("key") if isinstance(entry, dict) else entry
            if not key:
                continue
            inspect = run.rui_cmd("request", "inspect", "--store", run.store, "--key", key)
            (out / f"request-{key}.json").write_text(inspect.stdout + inspect.stderr)
            captures.append({"key": key, "entry": entry, "inspect_rc": inspect.returncode,
                             "inspect": inspect.stdout[:4000]})
    except Exception as error:
        captures.append({"error": repr(error)})
    provider = [r for r in read_jsonl(run.evidence / "provider.jsonl") if "kind" in r]
    injections = read_jsonl(run.evidence / "injections.jsonl")
    terms = {}
    for term in sorted((run.evidence / "terms").glob("*")) if (run.evidence / "terms").exists() else []:
        inputs = read_jsonl(term / "input.jsonl")
        terms[term.name] = {"input_chunks": len(inputs), "input_bytes": sum(i["n"] for i in inputs),
                            "frames": len(read_jsonl(term / "frames.jsonl")),
                            "exit": json.loads((term / "exit.json").read_text()) if (term / "exit.json").exists() else None}
    timeline = []
    for i in injections:
        timeline.append((i["t_ns"], "inject", i["term"], i.get("payload_text") or i.get("signal")))
    for term in terms:
        for chunk in read_jsonl(run.evidence / "terms" / term / "input.jsonl"):
            timeline.append((chunk["t_ns"], "received", term, chunk["text"]))
    for request in provider:
        timeline.append((request["t_ns"], "provider", request["kind"], request["user_text"]))
    timeline.sort()
    lines = [f"{t / 1e9:.6f} {kind:8} {who:16} {json.dumps(text, ensure_ascii=False)[:200]}" for t, kind, who, text in timeline]
    (run.evidence / "timeline.txt").write_text("\n".join(lines) + "\n")
    summary = {"t_ns": now_ns(), "wall": wall(), "sha": run.meta["sha"], "exports_rc": exports,
               "captures": captures, "provider_requests": [{k: r[k] for k in ("n", "kind", "user_text", "t_ns")} for r in provider],
               "terms": terms, "injections": len(injections)}
    (run.evidence / "summary.json").write_text(json.dumps(summary, indent=1, ensure_ascii=False))
    print(json.dumps(summary, indent=1, ensure_ascii=False)[:6000])
    print(f"timeline: {run.evidence / 'timeline.txt'}")


# ---------------------------------------------------------------- journey: the end-to-end compose/submit proof


def cmd_journey(args):
    """compose-submit: open demo, type a draft, verify draft cells, submit once,
    verify the answer, one provider request with the exact text, one new capture, then /exit restores."""
    run = Run(args.run)
    name = args.name
    text = args.text
    result = {"journey": "compose-submit", "surface": args.surface, "term": name, "sha": run.meta["sha"], "steps": []}

    def step(label, ok, **facts):
        result["steps"].append({"step": label, "ok": bool(ok), "t_ns": now_ns(), **facts})
        print(f"[{'ok ' if ok else 'BAD'}] {label} {json.dumps(facts, ensure_ascii=False)[:300]}", flush=True)
        return ok

    def helper(*argv, check=True):
        completed = subprocess.run([sys.executable, str(HERE), *argv], capture_output=True, text=True)
        if check and completed.returncode != 0:
            raise RuntimeError(f"{argv}: {completed.stderr.strip()}\n{completed.stdout[-2000:]}")
        return completed

    before_requests = len([r for r in read_jsonl(run.evidence / "provider.jsonl") if "kind" in r])
    before_captures = run.rui_cmd("request", "list").stdout
    try:
        helper("term", str(run.root), name, "--surface", args.surface, "--session", "demo", "--size", args.size)
        opened = helper("wait", str(run.root), name, "--marker", "›", "--composer", "--timeout", "20")
        gen = json.loads(opened.stdout.splitlines()[0])["gen"]
        step("open: composer ready", True, gen=gen)
        helper("screen", str(run.root), name, "--label", "01-opened")
        initial_input = read_jsonl(run.term_dir(name) / "input.jsonl")
        step("no input received before first injection", not initial_input or not [i for i in initial_input if not i["text"].startswith("\x1b[")],
             received=[i["text"] for i in initial_input])
        helper("send", str(run.root), name, "--text", text)
        drafted = helper("wait", str(run.root), name, "--marker", "› " + text, "--after", str(gen), "--timeout", "10")
        frame = json.loads(drafted.stdout.splitlines()[0])
        draft_line = drafted.stdout.splitlines()[1:][frame["cursor"][1]]
        step("draft cells show exactly the typed text at the caret row", draft_line == "› " + text and frame["cursor"][0] == 2 + len(text),
             line=draft_line, cursor=frame["cursor"])
        helper("screen", str(run.root), name, "--label", "02-draft")
        helper("send", str(run.root), name, "--keys", "Enter")
        answered = helper("wait", str(run.root), name, "--marker", "Fixture answer", "--composer", "--after", str(frame["gen"]), "--timeout", "20")
        answer_gen = json.loads(answered.stdout.splitlines()[0])["gen"]
        step("answer shown and composer ready", True, gen=answer_gen)
        helper("screen", str(run.root), name, "--label", "03-answered")
        time.sleep(1.0)
        provider = [r for r in read_jsonl(run.evidence / "provider.jsonl") if "kind" in r][before_requests:]
        step("exactly one provider request, carrying the exact text", len(provider) == 1 and provider[0]["user_text"] == text,
             requests=[(r["n"], r["user_text"]) for r in provider])
        received = "".join(i["text"] for i in read_jsonl(run.term_dir(name) / "input.jsonl"))
        step("received input bytes equal the injected text plus one CR", received.endswith(text + "\r") and received.count("\r") == 1,
             received=received)
        after_captures = run.rui_cmd("request", "list").stdout
        new_keys = sorted(set(json.loads(after_captures or "[]")) - set(json.loads(before_captures or "[]")))
        observed = None
        if len(new_keys) == 1:
            inspected = run.rui_cmd("request", "inspect", "--store", run.store, "--key", new_keys[0])
            observed = json.loads(inspected.stdout).get("observation", {}) if inspected.returncode == 0 else None
        capture_path = run.home / ".config/rui/requests" / f"{new_keys[0]}.json" if len(new_keys) == 1 else None
        captured = json.loads(capture_path.read_text()) if capture_path and capture_path.exists() else {}
        # input.sha256 is Rui's domain-separated content digest, so compare the
        # saved capture text and the inspected byte count instead.
        step("exactly one new capture key; its saved text is the exact draft and its request completed",
             observed is not None and captured.get("text", {}).get("value") == text and captured.get("session") == "demo"
             and observed.get("input", {}).get("bytes") == str(len(text.encode()))
             and observed.get("kind") == "message" and observed.get("result", {}).get("status") == "completed",
             new_keys=new_keys, captured_text=captured.get("text"), input=observed and observed.get("input"),
             result=observed and observed.get("result", {}).get("status"))
        helper("send", str(run.root), name, "--text", "/exit")
        helper("send", str(run.root), name, "--keys", "Enter")
        deadline = time.monotonic() + 10
        exit_path = run.term_dir(name) / "exit.json"
        while not exit_path.exists() and time.monotonic() < deadline:
            time.sleep(0.05)
        exited = json.loads(exit_path.read_text()) if exit_path.exists() else None
        step("/exit: Rui exits 0 with termios restored and alternate screen left",
             exited and exited["target_rc"] == "0" and exited["termios_restored"] and exited["alternate_screen_active_at_exit"] is False,
             exit=exited and {k: exited[k] for k in ("target_rc", "termios_restored", "alternate_screen_active_at_exit")},
             resume_hint=exited and (exited["main_screen_plain_tail"] or "")[-300:])
        if args.surface.startswith("tmux"):
            helper("screen", str(run.root), name, "--label", "04-after-exit")
    except Exception as error:
        step("journey aborted", False, error=str(error)[-1500:])
    result["verdict"] = "PASS" if all(s["ok"] for s in result["steps"]) else "ISSUES"
    out = run.evidence / f"journey-{name}.json"
    out.write_text(json.dumps(result, indent=1, ensure_ascii=False))
    print(result["verdict"], out)
    sys.exit(0 if result["verdict"] == "PASS" else 1)


def cmd_replay(args):
    """Re-feed a recorded terminal's received input bytes, with original gaps, into a new PTY terminal.

    Source may be another run (--from-run). The new terminal opens --session and waits for its
    composer first; chunks are replayed relative to the source's first received chunk.
    """
    run = Run(args.run)
    source_run = Run(args.from_run) if args.from_run else run
    chunks = read_jsonl(source_run.term_dir(args.source) / "input.jsonl")
    if args.skip_reports:
        chunks = [c for c in chunks if not re.fullmatch(r"(\x1b\[\?\d+;\d\$y)+", c["text"])]
    if not chunks:
        die("source terminal received no input")
    subprocess.run([sys.executable, str(HERE), "term", str(run.root), args.name, "--surface", "pty",
                    "--session", args.session, "--size", args.size], check=True, capture_output=True)
    subprocess.run([sys.executable, str(HERE), "wait", str(run.root), args.name, "--marker", "›", "--composer",
                    "--timeout", "20"], check=True, capture_output=True)
    start, origin = time.monotonic_ns(), chunks[0]["t_ns"]
    for chunk in chunks:
        delay = (chunk["t_ns"] - origin) - (time.monotonic_ns() - start)
        if delay > 0:
            time.sleep(delay / 1e9)
        fd = os.open(run.term_dir(args.name) / "in.fifo", os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, bytes.fromhex(chunk["hex"]))
        os.close(fd)
        append_jsonl(run.evidence / "injections.jsonl", {"t_ns": now_ns(), "wall": wall(), "term": args.name, "via": "replay",
                                                         "source": f"{source_run.root.name}/{args.source}@{chunk['offset']}",
                                                         "payload_hex": chunk["hex"], "payload_text": chunk["text"]})
    print(json.dumps({"replayed_chunks": len(chunks), "term": args.name}))


# ---------------------------------------------------------------- physical terminal handoff


def cmd_gui(args):
    """Open a real Terminal.app window attached to this run's tmux window, for a human's physical keys/wheel.

    Writes a .command file and opens it; the window's input reaches Rui through tmux and the tap,
    so input.jsonl records exactly what the physical terminal sent. Nothing is synthesized.
    """
    run = Run(args.run)
    record = term_record(run, args.name)
    if not record.get("tmux_target"):
        die("gui needs a tmux terminal")
    script = run.scratch / f"attach-{args.name}.command"
    script.write_text("#!/bin/sh\nprintf '\\033]0;verify-rui %s\\007'\nexec %s -S %s attach-session -t %s\n" % (
        args.name, shutil.which("tmux"), shlex.quote(str(run.sock)), shlex.quote(record["tmux_target"])))
    script.chmod(0o700)
    if args.open:
        subprocess.run(["open", "-a", args.app, str(script)], check=True)
    append_jsonl(run.evidence / "injections.jsonl", {"t_ns": now_ns(), "wall": wall(), "term": args.name, "via": "gui-open",
                                                     "app": args.app, "script": str(script), "opened": args.open})
    print(f"attach script: {script}")
    print("Physical checklist (a human types these in that window; input.jsonl records the bytes):")
    for item in ("type 'hello' then Enter", "PgUp, PgDn", "Ctrl-G", "mouse wheel up 3 notches, down 3 notches",
                 "arrow Up x3, Down x3", "Esc", "on an Action prompt: 'a' Enter (or 'd' Enter)", "Ctrl-C"):
        print(f"  - {item}")


# ---------------------------------------------------------------- physical session (L4) with automatic grading

PHYSICAL_STEPS = [
    # id, instruction shown to the human, grader name, timeout seconds
    ("type", "Click once inside the Rui window, then TYPE exactly:  hello physical\n(do not press Enter yet)", "type", 60),
    ("enter", "Press  Enter  once.", "submit", 40),
    ("pgup", "Press  Page Up  twice  (laptop: fn + Up arrow).", "pgup", 40),
    ("ctrl-g", "Press  Control-G  (back to the latest messages).", "ctrl_g", 30),
    ("wheel-up", "Over the Rui window, scroll the mouse wheel or trackpad UP a few notches.", "wheel_up", 40),
    ("wheel-down", "Scroll DOWN until you are back at the bottom (the  ›  prompt is live).", "wheel_down", 40),
    ("arrows", "Press  Up arrow  three times, then  Down arrow  three times.", "arrows", 40),
    ("esc", "Press  Page Up  once, then  Esc.", "esc", 40),
    ("consent", "TYPE:  consent check   then press  Enter.", "consent_shown", 60),
    ("read", "Press  Page Down  until this coach says the choices are enabled.", "consent_read", 60),
    ("allow", "TYPE  a  then press  Enter  (allow once).", "allow", 60),
    ("deny", "TYPE:  consent check  + Enter, press  Page Down  until enabled, then TYPE  d  + Enter  (deny).", "deny", 120),
    ("ctrl-c", "Press  Control-C  (Rui closes; the window shows 'Detached').", "ctrl_c", 30),
]
TMUX_STEPS = [
    ("tmux-type", "In the NEW tmux window: click inside it, TYPE  hello tmux  and press  Enter.", "tmux_submit", 90),
    ("tmux-wheel", "Over the tmux window, scroll the wheel UP a few notches, then press  Control-G.", "tmux_wheel", 60),
    ("tmux-status", "TYPE  /status  and press  Enter.", "tmux_status", 40),
    ("tmux-exit", "Press  Esc, then  Control-C.", "tmux_exit", 40),
]
UP = (b"\x1b[A", b"\x1bOA")
DOWN = (b"\x1b[B", b"\x1bOB")


class Grader:
    """Reads only this run's evidence: bytes Rui received, committed frames, provider, captures, files."""

    def __init__(self, run, term):
        self.run, self.term = run, term
        self.mark()

    def mark(self):
        self.inputs_at = len(read_jsonl(self.run.term_dir(self.term) / "input.jsonl"))
        self.frames_at = len(frames(self.run, self.term))
        self.provider_at = len([r for r in read_jsonl(self.run.evidence / "provider.jsonl") if "kind" in r])
        self.keys_at = set(json.loads(self.run.rui_cmd("request", "list", log=False).stdout or "[]"))
        self.t0 = now_ns()

    def received(self):
        chunks = read_jsonl(self.run.term_dir(self.term) / "input.jsonl")[self.inputs_at:]
        return chunks, b"".join(bytes.fromhex(c["hex"]) for c in chunks)

    def new_frames(self):
        return frames(self.run, self.term)[self.frames_at:]

    def provider(self):
        return [r for r in read_jsonl(self.run.evidence / "provider.jsonl") if "kind" in r][self.provider_at:]

    def latest(self):
        """What is shown now: an unchanged screen commits no new frame."""
        return (frames(self.run, self.term) or [None])[-1]

    def live(self, frame):
        return frame and not frame["screen"].startswith("Browsing") and composer_ready(frame["screen"], frame["cursor"])

    def progress_lines(self):
        path = self.run.project / "progress.log"
        return len(path.read_text().splitlines()) if path.exists() else 0

    def new_captures(self):
        keys = set(json.loads(self.run.rui_cmd("request", "list", log=False).stdout or "[]")) - self.keys_at
        out = []
        for key in sorted(keys):
            path = self.run.home / ".config/rui/requests" / f"{key}.json"
            out.append({"key": key, "capture": json.loads(path.read_text()) if path.exists() else None})
        return out

    # Each grader returns (done, facts). done=True means the expected physical effect was observed.
    def type(self):
        chunks, data = self.received()
        typed = [c for c in chunks if not c["text"].startswith("\x1b")]
        shown = any("› hello physical" in f["screen"].split("\n")[f["cursor"][1]] for f in self.new_frames()
                    if f["cursor"][1] < len(f["screen"].split("\n")))
        return (b"hello physical" in data and shown and len(typed) >= 5 and b"\x1b[200~" not in data,
                {"typed_chunks": len(typed), "paste_marker": b"\x1b[200~" in data, "draft_shown": shown,
                 "non_key_bytes": [c["text"] for c in chunks if c["text"].startswith("\x1b")]})

    def submit(self, text="hello physical", marker="Fixture answer"):
        _, data = self.received()
        provider = self.provider()
        captures = self.new_captures()
        answered = any(marker in f["screen"] for f in self.new_frames())
        ok = (data.count(b"\r") == 1 and len(provider) == 1 and provider[0]["user_text"] == text and len(captures) == 1
              and (captures[0]["capture"] or {}).get("text", {}).get("value") == text and answered)
        return ok, {"cr_received": data.count(b"\r"), "provider": [(p["n"], p["user_text"]) for p in provider],
                    "captures": captures, "answered": answered}

    def pgup(self):
        _, data = self.received()
        browsing = any(f["screen"].startswith("Browsing") for f in self.new_frames())
        count = data.count(b"\x1b[5~") + data.count(b"\x1b[5;2~")
        return count >= 2 and browsing, {"pgup_sequences": count, "browsing_frame": browsing, "bytes": data.hex()}

    def ctrl_g(self):
        _, data = self.received()
        last = self.latest()
        return b"\x07" in data and bool(self.live(last)), {"ctrl_g": b"\x07" in data, "live": bool(self.live(last))}

    def wheel_up(self):
        _, data = self.received()
        ups = sum(data.count(seq) for seq in UP)
        mouse = data.count(b"\x1b[<") + data.count(b"\x1b[M")
        moved = any(f["screen"].startswith("Browsing") for f in self.new_frames())
        return (ups + mouse) >= 1 and moved, {"arrow_up_sequences": ups, "mouse_reports": mouse, "scrolled": moved,
                                              "bytes": data.hex()[:400]}

    def wheel_down(self):
        _, data = self.received()
        downs = sum(data.count(seq) for seq in DOWN)
        last = self.latest()
        return downs >= 1 and bool(self.live(last)), {"arrow_down_sequences": downs, "live": bool(self.live(last))}

    def arrows(self):
        _, data = self.received()
        ups, downs = sum(data.count(s) for s in UP), sum(data.count(s) for s in DOWN)
        last = self.latest()
        return ups >= 3 and downs >= 3 and bool(self.live(last)), {"up": ups, "down": downs, "live": bool(self.live(last))}

    def esc(self):
        chunks, data = self.received()
        lone_esc = any(c["hex"] == "1b" for c in chunks)
        browsed = any(f["screen"].startswith("Browsing") for f in self.new_frames())
        last = self.latest()
        return lone_esc and browsed and bool(self.live(last)), {"lone_esc": lone_esc, "browsed": browsed, "live": bool(self.live(last))}

    def consent_shown(self):
        shown = [f for f in self.new_frames() if "Run Bash" in f["screen"]]
        provider = self.provider()
        return bool(shown) and any(p["kind"] == "consent-call" for p in provider), {
            "prompt_frame_gen": shown[0]["gen"] if shown else None, "provider": [(p["n"], p["kind"]) for p in provider]}

    def consent_read(self):
        _, data = self.received()
        enabled = [f for f in self.new_frames() if "wc -l progress.log" in f["screen"] and "a + Enter" in f["screen"]]
        return data.count(b"\x1b[6~") >= 1 and bool(enabled), {"pgdn_sequences": data.count(b"\x1b[6~"),
                                                               "enabled_frame_gen": enabled[0]["gen"] if enabled else None}

    def allow(self):
        _, data = self.received()
        lines = self.progress_lines()
        summary = any(p["kind"] == "tool-summary" for p in self.provider())
        return b"a" in data and b"\r" in data and lines == 30 and summary, {"progress_lines": lines, "tool_summary_request": summary}

    def deny(self):
        _, data = self.received()
        provider = self.provider()
        lines = self.progress_lines()
        proposed = any(p["kind"] == "consent-call" for p in provider)
        summary = any(p["kind"] == "tool-summary" for p in provider)
        return proposed and summary and b"d\r" in data.replace(b"\x1b[6~", b"") and lines == 30, {
            "progress_lines": lines, "proposed": proposed, "tool_result_delivered": summary}

    def ctrl_c(self):
        exit_path = self.run.term_dir(self.term) / "exit.json"
        exited = json.loads(exit_path.read_text()) if exit_path.exists() else None
        _, data = self.received()
        ok = exited is not None and b"\x03" in data and exited["target_rc"] == "0" and exited["termios_restored"] \
            and exited["alternate_screen_active_at_exit"] is False
        return ok, {"ctrl_c": b"\x03" in data, "exit": exited and {k: exited[k] for k in
                    ("target_rc", "termios_restored", "alternate_screen_active_at_exit")}}

    def tmux_submit(self):
        return self.submit("hello tmux")

    def tmux_wheel(self):
        _, data = self.received()
        ups = sum(data.count(seq) for seq in UP)
        moved = any(f["screen"].startswith("Browsing") for f in self.new_frames())
        last = self.latest()
        return ups >= 1 and moved and b"\x07" in data and bool(self.live(last)), {
            "arrow_up_sequences": ups, "scrolled": moved, "back_live": bool(self.live(last)), "bytes": data.hex()[:400]}

    def tmux_status(self):
        page = [f for f in self.new_frames() if "Session: demo" in f["screen"] and "Work:" in f["screen"]]
        return bool(page) and not self.provider(), {"status_frame_gen": page[0]["gen"] if page else None,
                                                    "provider_requests": len(self.provider())}

    def tmux_exit(self):
        return self.ctrl_c()


def coach_write(run, lines):
    atomic_write(run.evidence / "physical" / "coach.txt", "\n".join(lines) + "\n")


def cmd_coach_view(args):
    """Runs inside the coach window: shows coach.txt; no input is read or recorded."""
    path = pathlib.Path(args.run) / "evidence" / "physical" / "coach.txt"
    (path.parent / "coach-view.pid").write_text(str(os.getpid()))
    shown = None
    while True:
        text = path.read_text() if path.exists() else "waiting for verify-rui…\n"
        if text != shown:
            sys.stdout.write("\x1b[2J\x1b[H" + text)
            sys.stdout.flush()
            shown = text
            if text.startswith("DONE"):
                return
        time.sleep(0.2)


REHEARSAL_INPUT = {
    "type": [b"hello physical"], "enter": [b"\r"], "pgup": [b"\x1b[5~", b"\x1b[5~"], "ctrl-g": [b"\x07"],
    "wheel-up": [b"\x1b[A"] * 3, "wheel-down": [b"\x1b[B"] * 3, "arrows": [b"\x1b[A"] * 3 + [b"\x1b[B"] * 3,
    "esc": [b"\x1b[5~", b"\x1b"], "consent": [b"consent check", b"\r"], "read": [b"\x1b[6~"] * 4,
    "allow": [b"a", b"\r"], "deny": [b"consent check", b"\r", b"WAIT:Run Bash"] + [b"\x1b[6~"] * 4 + [b"d", b"\r"],
    "ctrl-c": [b"\x03"], "tmux-type": [b"hello tmux", b"\r"], "tmux-wheel": [b"\x1b[A"] * 3 + [b"\x07"],
    "tmux-status": [b"/status", b"\r"], "tmux-exit": [b"\x1b", b"\x03"],
}


def rehearse_inject(run, term, step, via):
    """Synthetic stand-in for the human. Typing goes one byte per write, like key presses."""
    for payload in REHEARSAL_INPUT[step]:
        if payload.startswith(b"WAIT:"):
            marker = payload[5:].decode()
            deadline = time.monotonic() + 20
            while time.monotonic() < deadline and not any(marker in f["screen"] for f in frames(run, term)[-3:]):
                time.sleep(0.1)
            continue
        pieces = [bytes([b]) for b in payload] if not payload.startswith(b"\x1b") and len(payload) > 1 else [payload]
        for piece in pieces:
            subprocess.run([sys.executable, str(HERE), "send", str(run.root), term, "--hex", piece.hex(), "--via", via],
                           check=True, capture_output=True)
            time.sleep(0.06 if len(pieces) > 1 else 0.6)


def cmd_physical(args):
    """Guided ~5-minute physical-input session, graded automatically from owned evidence."""
    created = subprocess.run([sys.executable, str(HERE), "new", args.sha, "--seed", "4",
                              "--label", "physical-rehearsal" if args.rehearse else "physical"], capture_output=True, text=True)
    if created.returncode != 0:
        die(f"new run failed: {created.stderr}")
    run = Run(created.stdout.strip().splitlines()[-1])
    doctor = subprocess.run([sys.executable, str(HERE), "doctor", str(run.root), "--expect-sha", args.sha], capture_output=True, text=True)
    if doctor.returncode != 0:
        print(doctor.stdout)
        die("doctor failed; not driving this run")
    physical = run.evidence / "physical"
    physical.mkdir(parents=True)
    mode = "REHEARSAL (synthetic L1/L3 input; validates tooling only, NOT physical evidence)" if args.rehearse \
        else "SMOKE (GUI launch and restore only; no input, NOT physical evidence)" if args.smoke \
        else "PHYSICAL (L4: a human's keyboard, wheel and trackpad in Terminal.app)"
    print(f"run: {run.root}\nmode: {mode}\nbuild: {run.meta['sha']} rui sha256 {run.meta['binary_sha256']}")
    results = {"mode": mode, "rehearsal": args.rehearse, "sha": run.meta["sha"], "binary_sha256": run.meta["binary_sha256"],
               "run": str(run.root), "app": args.app, "started": wall(), "steps": []}
    python = sys.executable

    def open_gui_tap(name, argv, columns_rows="100x30"):
        term = run.term_dir(name)
        term.mkdir(parents=True)
        env_file = term / "env.json"
        env_file.write_text(json.dumps(run.env(COLORTERM="truecolor")))
        script = run.scratch / f"{name}.command"
        script.write_text("#!/bin/sh\nprintf '\\033]0;verify-rui %s (owned test window)\\007'\nexec %s %s _tap %s --source %s --cwd %s --env @%s --mode terminal --hold -- %s\n" % (
            name, shlex.quote(python), shlex.quote(str(HERE)), shlex.quote(str(term)), shlex.quote(run.meta["source"]),
            shlex.quote(str(run.project)), shlex.quote(str(env_file)), shlex.join(argv)))
        script.chmod(0o700)
        atomic_write(term / "term.json", json.dumps({"name": name, "surface": "gui", "app": args.app, "argv": argv, "script": str(script)}, indent=1))
        subprocess.run(["open", "-a", args.app, str(script)], check=True)
        wait_meta(term, timeout=30)
        meta = json.loads((term / "meta.json").read_text())
        run.own("tap", meta["tap_pid"], term=name)
        append_jsonl(run.evidence / "injections.jsonl", {"t_ns": now_ns(), "wall": wall(), "term": name, "via": "gui-open", "app": args.app})

    def run_steps(term, steps, via):
        grader = Grader(run, term)
        for index, (step_id, instruction, grade, timeout) in enumerate(steps, 1):
            grader.mark()
            started, deadline = now_ns(), time.monotonic() + timeout
            coach_write(run, [f"verify-rui physical session — {mode}", f"step {index}/{len(steps)}  [{step_id}]", "",
                              instruction, "", f"(waiting up to {timeout}s; this window only shows instructions)"])
            print(f"[{step_id}] {instruction.splitlines()[0]}", flush=True)
            if args.rehearse and step_id not in (args.rehearse_omit or []):
                rehearse_inject(run, term, step_id, via)
            done, facts = False, {}
            while time.monotonic() < deadline:
                done, facts = getattr(grader, grade)()
                if done:
                    break
                time.sleep(0.25)
            if done and grade in ("submit", "tmux_submit", "allow", "deny"):
                time.sleep(1.0)  # catch a late duplicate before grading final
                done, facts = getattr(grader, grade)()
            chunks, _ = grader.received()
            record = {"step": step_id, "term": term, "instruction": instruction, "result": "PASS" if done else "MISSING",
                      "t_start_ns": started, "t_end_ns": now_ns(), "facts": facts,
                      "received": [{"t_ns": c["t_ns"], "hex": c["hex"], "text": c["text"]} for c in chunks],
                      "input_layer": "L1-FIFO synthetic" if args.rehearse and via == "fifo" else ("L3 synthetic client bytes" if args.rehearse else "L4 physical")}
            results["steps"].append(record)
            append_jsonl(physical / "steps.jsonl", record)
            subprocess.run([sys.executable, str(HERE), "screen", str(run.root), term, "--label", f"phys-{index:02d}-{step_id}"],
                           capture_output=True)
            print(f"   -> {record['result']} {json.dumps(facts, ensure_ascii=False)[:300]}", flush=True)
            if not done and step_id in ("ctrl-c", "tmux-exit"):
                pass
            elif not done:
                coach_write(run, [f"step {step_id}: not observed — moving on", "", instruction])
                time.sleep(2)

    try:
        if args.rehearse:
            subprocess.run([sys.executable, str(HERE), "term", str(run.root), "phys", "--surface", "pty", "--session", "approve",
                            "--size", "100x30"], check=True, capture_output=True)
        else:
            open_gui_tap("phys", [str(run.rui), "session", "resume", "--store", str(run.store), "--", "approve"])
            coach_script = run.scratch / "coach.command"
            coach_script.write_text("#!/bin/sh\nprintf '\\033]0;verify-rui COACH (read only)\\007'\nexec %s %s _coach-view %s\n" % (
                shlex.quote(python), shlex.quote(str(HERE)), shlex.quote(str(run.root))))
            coach_script.chmod(0o700)
            coach_write(run, ["verify-rui physical session", "", "Starting… the Rui window is the other new window."])
            subprocess.run(["open", "-a", args.app, str(coach_script)], check=True)
            deadline = time.monotonic() + 20
            while not (physical / "coach-view.pid").exists() and time.monotonic() < deadline:
                time.sleep(0.1)
            if (physical / "coach-view.pid").exists():
                run.own("coach-view", int((physical / "coach-view.pid").read_text()))
        subprocess.run([sys.executable, str(HERE), "wait", str(run.root), "phys", "--marker", "›", "--composer", "--timeout", "30"],
                       check=True, capture_output=True)
        if args.smoke:
            # Launch check only: the owned GUI window reached Rui's composer; end it by SIGTERM.
            subprocess.run([sys.executable, str(HERE), "screen", str(run.root), "phys", "--label", "smoke-composer"], capture_output=True)
            subprocess.run([sys.executable, str(HERE), "signal", str(run.root), "phys", "TERM"], check=True, capture_output=True)
            deadline = time.monotonic() + 10
            while not (run.term_dir("phys") / "exit.json").exists() and time.monotonic() < deadline:
                time.sleep(0.1)
            exited = json.loads((run.term_dir("phys") / "exit.json").read_text()) if (run.term_dir("phys") / "exit.json").exists() else None
            ok = bool(exited and exited["target_rc"] == "0" and exited["termios_restored"] and exited["alternate_screen_active_at_exit"] is False)
            received = read_jsonl(run.term_dir("phys") / "input.jsonl")
            results["steps"].append({"step": "smoke-launch", "result": "PASS" if ok else "MISSING", "input_layer": "none (no input injected)",
                                     "facts": {"exit": exited and {k: exited[k] for k in ("target_rc", "termios_restored", "alternate_screen_active_at_exit")},
                                               "terminal_replies_received": [c["text"] for c in received]}})
            print(json.dumps(results["steps"][-1], ensure_ascii=False))
            return
        run_steps("phys", PHYSICAL_STEPS, "fifo")
        if not args.no_tmux:
            subprocess.run([sys.executable, str(HERE), "term", str(run.root), "phys-tmux", "--surface",
                            "tmux-attached" if args.rehearse else "tmux-detached", "--session", "demo", "--size", "100x30"],
                           check=True, capture_output=True)
            if not args.rehearse:
                subprocess.run([sys.executable, str(HERE), "gui", str(run.root), "phys-tmux", "--open", "--app", args.app],
                               check=True, capture_output=True)
            subprocess.run([sys.executable, str(HERE), "wait", str(run.root), "phys-tmux", "--marker", "›", "--composer", "--timeout", "30"],
                           check=True, capture_output=True)
            run_steps("phys-tmux", TMUX_STEPS, "client")
    finally:
        missing = [s["step"] for s in results["steps"] if s["result"] != "PASS"]
        expected = 1 if args.smoke else len(PHYSICAL_STEPS) + (0 if args.no_tmux else len(TMUX_STEPS))
        results["ended"] = wall()
        results["missing"] = missing
        results["incomplete"] = len(results["steps"]) < expected
        results["verdict"] = ("REHEARSAL-" if args.rehearse else "SMOKE-" if args.smoke else "") + ("PASS" if not missing and not results["incomplete"] else "ISSUES")
        (physical / "result.json").write_text(json.dumps(results, indent=1, ensure_ascii=False))
        coach_write(run, [f"DONE  verdict: {results['verdict']}", f"missing: {missing or 'none'}", "You can close both verify-rui windows."])
        print(f"\nVERDICT {results['verdict']}  missing={missing}  result: {physical / 'result.json'}")
        if missing or results["incomplete"]:
            print("FAIL: physical events missing — these rows are NOT verified.", file=sys.stderr)
        if not args.keep:
            subprocess.run([sys.executable, str(HERE), "cleanup", str(run.root)], capture_output=True)
            print(f"cleaned up; evidence preserved under {run.evidence}")
    sys.exit(0 if results["verdict"].endswith("PASS") else 1)


# ---------------------------------------------------------------- cleanup


def cmd_cleanup(args):
    """Stop exactly what this run started; preserve evidence (and a Store archive)."""
    run = Run(args.run)
    report = {"t_ns": now_ns(), "wall": wall(), "actions": []}

    def act(what, **facts):
        report["actions"].append({"action": what, **facts})
        print(what, json.dumps(facts)[:300])

    if not args.no_export:
        try:
            subprocess.run([sys.executable, str(HERE), "evidence", str(run.root)], capture_output=True, timeout=120)
            act("exported evidence")
        except Exception as error:
            act("export failed", error=repr(error))
    for meta_path in sorted((run.evidence / "terms").glob("*/meta.json")) if (run.evidence / "terms").exists() else []:
        meta = json.loads(meta_path.read_text())
        wrapper = process_start(meta["child_pid"])
        if wrapper and wrapper[0] == meta["child_lstart"]:
            for child in subprocess.run(["pgrep", "-P", str(meta["child_pid"])], capture_output=True, text=True).stdout.split():
                os.kill(int(child), signal.SIGTERM)
                act("SIGTERM live client of owned terminal", term=meta_path.parent.name, pid=int(child))
            time.sleep(0.5)
    if run.sock.exists():
        result = run.tmux("kill-server", check=False)
        act("tmux kill-server (private socket)", socket=str(run.sock), rc=result.returncode)
    stop = run.rui_cmd("host", "pause", "--store", run.store) if run.store.exists() else None
    act("rui host pause", rc=stop and stop.returncode)
    deadline = time.monotonic() + 15
    for record in reversed(run.owned()):
        pid = record["pid"]
        while True:
            current = process_start(pid)
            if current is None or current[0] != record["lstart"]:
                act(f"{record['kind']} {pid} gone", now=current)
                break
            if time.monotonic() > deadline or record["kind"] != "host":
                os.kill(pid, signal.SIGTERM if record["kind"] != "host" else signal.SIGKILL)
                act(f"signalled owned {record['kind']} {pid}", lstart=record["lstart"])
                time.sleep(0.3)
                if process_start(pid) is not None and process_start(pid)[0] == record["lstart"]:
                    os.kill(pid, signal.SIGKILL)
                    act(f"SIGKILL owned {record['kind']} {pid}")
                continue
            time.sleep(0.2)
    if run.store.exists():
        with tarfile.open(run.evidence / "store-after.tgz", "w:gz") as archive:
            archive.add(run.store, arcname="store")
        act("archived Store into evidence", path=str(run.evidence / "store-after.tgz"))
    if run.scratch.exists() and str(run.scratch.resolve()).startswith(str(SCRATCH_PARENT.resolve() / "vr.")):
        shutil.rmtree(run.scratch)
        act("removed scratch (synthetic HOME, Store, project, sockets)", path=str(run.scratch))
    survivors = [r for r in run.owned() if process_start(r["pid"]) and process_start(r["pid"])[0] == r["lstart"]]
    report["survivors"] = survivors
    report["evidence_files"] = sum(1 for _ in run.evidence.rglob("*") if _.is_file())
    append_jsonl(run.root / "cleanup.jsonl", report)
    print(json.dumps({"survivors": survivors, "evidence": str(run.evidence), "evidence_files": report["evidence_files"]}))
    sys.exit(1 if survivors else 0)


def cmd_list(_args):
    for root in sorted((CACHE / "runs").glob("*")):
        meta = json.loads((root / "run.json").read_text())
        cleaned = (root / "cleanup.jsonl").exists()
        print(f"{root}  sha={meta['sha'][:12]} label={meta.get('label')} {'cleaned' if cleaned else 'LIVE'}")


# ---------------------------------------------------------------- named frames (plain tmux, no screen library)


THEMES = {"night": ("#121933", "#d4cebf"), "day": ("#f3eee2", "#2f2b25"), "mist": ("#e6e9ef", "#2f2b25")}
ANSI_BASE = ["#000000", "#cd3131", "#0dbc79", "#e5e510", "#2472c8", "#bc3fbc", "#11a8cd", "#e5e5e5",
             "#666666", "#f14c4c", "#23d18b", "#f5f543", "#3b8eea", "#d670d6", "#29b8db", "#ffffff"]


ANSI_ESCAPE = re.compile(r"\x1b\[([0-9;:]*)m|\x1b\]8;[^\x1b\x07]*(?:\x1b\\|\x07)|\x1b\([B0]|\x0e|\x0f")


def ansi_color(n):
    if not 0 <= n <= 255:
        return None
    if n < 16:
        return ANSI_BASE[n]
    if n < 232:
        n -= 16
        levels = [0, 95, 135, 175, 215, 255]
        return "#%02x%02x%02x" % (levels[n // 36], levels[n // 6 % 6], levels[n % 6])
    return "#%02x%02x%02x" % ((8 + 10 * (n - 232),) * 3)


def ansi_render(text, bg, fg):
    """Render tmux SGR (including indexed/RGB colours) without interpreting HTML."""
    default = dict(fg=None, bg=None, bold=False, dim=False, ital=False, ul=False, rev=False, strike=False)
    style = default.copy()
    out = []

    def span(chunk):
        f, b = style["fg"] or fg, style["bg"] or bg
        if style["rev"]:
            f, b = b, f
        css = [f"color:{f}"]
        if b != bg:
            css.append(f"background:{b}")
        for key, rule in (("bold", "font-weight:700"), ("dim", "opacity:.6"), ("ital", "font-style:italic")):
            if style[key]:
                css.append(rule)
        deco = [d for d, key in (("underline", "ul"), ("line-through", "strike")) if style[key]]
        if deco:
            css.append("text-decoration:" + " ".join(deco))
        return f'<span style="{";".join(css)}">{html.escape(chunk)}</span>'

    pos = 0
    for match in ANSI_ESCAPE.finditer(text):
        if match.start() > pos:
            out.append(span(text[pos:match.start()]))
        pos = match.end()
        if match.group(1) is None:
            continue
        fields = match.group(1).split(";")
        i = 0
        while i < len(fields):
            parts = [int(v or 0) for v in fields[i].split(":")]
            value = parts[0]
            if value == 0:
                style = default.copy()
            elif value in (38, 48):
                key = "fg" if value == 38 else "bg"
                if len(parts) > 1:
                    colour = parts[1:]
                else:
                    colour = [int(v or 0) for v in fields[i + 1:i + 5] if ":" not in v]
                    count = 2 if colour and colour[0] == 5 else 4 if colour and colour[0] == 2 else 0
                    i += min(count, len(fields) - i - 1)
                if len(colour) >= 2 and colour[0] == 5:
                    style[key] = ansi_color(colour[1])
                elif len(colour) >= 4 and colour[0] == 2 and all(0 <= v <= 255 for v in colour[-3:]):
                    style[key] = "#%02x%02x%02x" % tuple(colour[-3:])
            elif 30 <= value <= 37:
                style["fg"] = ANSI_BASE[value - 30]
            elif 90 <= value <= 97:
                style["fg"] = ANSI_BASE[value - 90 + 8]
            elif 40 <= value <= 47:
                style["bg"] = ANSI_BASE[value - 40]
            elif 100 <= value <= 107:
                style["bg"] = ANSI_BASE[value - 100 + 8]
            elif value in (39, 49):
                style["fg" if value == 39 else "bg"] = None
            else:
                toggles = {1: ("bold", True), 2: ("dim", True), 3: ("ital", True), 4: ("ul", True),
                           7: ("rev", True), 9: ("strike", True), 23: ("ital", False), 24: ("ul", False),
                           27: ("rev", False), 29: ("strike", False)}
                if value == 22:
                    style["bold"] = style["dim"] = False
                elif value in toggles:
                    key, enabled = toggles[value]
                    style[key] = enabled
            i += 1
    if pos < len(text):
        out.append(span(text[pos:]))
    return "".join(out)


def ansi_page(body, bg, fg, cols, rows, cursor):
    cx, cy = cursor
    return f"""<!doctype html><meta charset=utf-8><style>
body{{margin:0;background:#0000}}
#t{{display:inline-block;padding:14px 16px;background:{bg};border-radius:10px;position:relative}}
pre{{margin:0;font:14px/1.35 'JetBrains Mono','DejaVu Sans Mono',monospace;color:{fg};width:{cols}ch;height:{rows * 1.35}em;overflow:hidden;position:relative;font-variant-ligatures:none}}
#c{{position:absolute;left:{cx}ch;top:{cy * 1.35}em;width:1ch;height:1.35em;background:{fg};opacity:.55}}
</style><div id=t><pre>{body}<i id=c></i></pre></div>"""


def parse_sizes(value):
    """Normalize scenario or CLI sizes to (columns, rows), before execution."""
    values = value.split(",") if isinstance(value, str) else value
    if not isinstance(values, list) or not values:
        raise ValueError("sizes must be a nonempty list or comma-separated WxH values")
    result = []
    for size in values:
        if not isinstance(size, str) or not re.fullmatch(r"[1-9][0-9]*x[1-9][0-9]*", size):
            raise ValueError(f"invalid size {size!r}; expected positive WxH")
        dimensions = tuple(map(int, size.split("x")))
        if dimensions in result:
            raise ValueError(f"duplicate size {size}")
        result.append(dimensions)
    return result


def size_name(size):
    cols, rows = size
    return f"{cols}x{rows}"


def frame_expectations(state):
    """One expectation policy for validation and the capture owner."""
    if "expect" in state:
        value = state["expect"]
    else:
        steps = state["steps"]
        last_wait = next((index for index in range(len(steps) - 1, -1, -1) if "wait" in steps[index]), None)
        if last_wait is not None and any(set(step) & {"text", "keys", "send", "host"} for step in steps[last_wait + 1:]):
            raise ValueError(f"{state['name']}: an action follows the last wait; set expect explicitly")
        value = steps[last_wait]["wait"] if last_wait is not None else []
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, list) or not all(isinstance(text, str) and text and "\0" not in text for text in value):
        raise ValueError(f"{state['name']}: expect must be text or a list of nonempty text markers")
    return value


def frame_absences(state):
    value = state.get("absent", [])
    if not isinstance(value, list) or not all(isinstance(text, str) and text and "\0" not in text for text in value):
        raise ValueError(f"{state['name']}: absent must be a list of nonempty text markers")
    return value


def cast_entries(entries):
    for entry in entries:
        for n in range(1, entry.get("count", 1) + 1):
            yield {**entry, "label": entry["label"].replace("{n}", str(n))}


def validate_scenario(data, sizes=None):
    """Validate before allocating a run or sending any side effects."""
    def require(ok, message):
        if not ok:
            raise ValueError(message)

    def duration(value):
        return type(value) in (int, float) and math.isfinite(value) and value >= 0

    require(isinstance(data, dict), "scenario must be an object")
    default_sizes = parse_sizes(data.get("sizes"))
    override = parse_sizes(sizes) if sizes is not None else None
    normalized_states = []
    states = data.get("states")
    require(isinstance(states, list) and bool(states), "states must be a nonempty list")
    names, labels = set(), set()
    for state in states:
        require(isinstance(state, dict), "state must be an object")
        name = state.get("name")
        require(isinstance(name, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", name), "invalid state name")
        require(name not in names, f"duplicate state {name}")
        names.add(name)
        require(isinstance(state.get("theme", "night"), str) and state.get("theme", "night") in THEMES, f"{name}: invalid theme")
        env = state.get("env", {})
        require(isinstance(env, dict) and all(isinstance(k, str) and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k)
                                             and isinstance(v, str) and "\0" not in v for k, v in env.items()), f"{name}: invalid env")
        require("note" not in state or isinstance(state["note"], str) and "\n" not in state["note"], f"{name}: note must be one line")
        state_sizes = parse_sizes(state["sizes"]) if "sizes" in state else default_sizes
        cast = state.get("cast", [])
        require(isinstance(cast, list), f"{name}: cast must be a list")
        for entry in cast:
            require(isinstance(entry, dict), f"{name}: cast entry must be an object")
            label, workspace = entry.get("label"), entry.get("workspace")
            require(isinstance(label, str) and bool(label) and "\n" not in label, f"{name}: invalid cast label")
            require(isinstance(workspace, str) and bool(workspace) and not pathlib.PurePath(workspace).is_absolute()
                    and ".." not in pathlib.PurePath(workspace).parts, f"{name}: workspace must be relative to HOME")
            require(entry.get("mode") in ("bypass", "ask"), f"{name}: invalid cast mode")
            require(entry.get("settle", "answered") in ("answered", "pending", "stop"), f"{name}: invalid settle")
            require(type(entry.get("count", 1)) is int and entry.get("count", 1) > 0, f"{name}: count must be positive")
            require("count" not in entry or "{n}" in label, f"{name}: counted label must contain {{n}}")
            require(all(isinstance(entry.get(k, ""), str) for k in ("model", "effort")), f"{name}: invalid model/effort")
            messages = entry.get("messages")
            require(isinstance(messages, list) and bool(messages) and all(isinstance(m, str) and m for m in messages), f"{name}: messages must be nonempty strings")
        for entry in cast_entries(cast):
            require(entry["label"] not in labels and entry["label"] != "overview", f"{name}: duplicate/reserved cast label {entry['label']}")
            labels.add(entry["label"])
        require(isinstance(state.get("open"), str) and (state["open"] == "overview" or state["open"] in labels), f"{name}: unknown cast label in open: {state.get('open')}")
        steps = state.get("steps")
        require(isinstance(steps, list), f"{name}: steps must be a list")
        for step in steps:
            require(isinstance(step, dict), f"{name}: step must be an object")
            actions = set(step) - {"timeout"}
            require(len(actions) == 1 and actions <= {"text", "keys", "wait", "gone", "sleep", "send", "host"}, f"{name}: unknown or ambiguous step {step}")
            action = next(iter(actions))
            value = step[action]
            require("timeout" not in step or action in ("wait", "gone") and duration(step["timeout"]), f"{name}: invalid timeout")
            if action in ("text", "wait", "gone"):
                require(isinstance(value, str) and "\0" not in value, f"{name}: {action} must be text")
            elif action == "keys":
                require(isinstance(value, list) and bool(value) and all(isinstance(k, str) and k in KEYS for k in value), f"{name}: unknown key")
            elif action == "sleep":
                require(duration(value), f"{name}: invalid sleep")
            elif action == "host":
                require(value in ("pause", "start"), f"{name}: invalid host action")
            else:
                require(isinstance(value, dict) and isinstance(value.get("to"), str) and value["to"] in labels and isinstance(value.get("text"), str)
                        and type(value.get("wait", True)) is bool, f"{name}: invalid send or unknown cast label")
        normalized_states.append({**state, "sizes": override or state_sizes, "expect": frame_expectations(state),
                                  "absent": frame_absences(state)})
    return {**data, "sizes": override or default_sizes, "states": normalized_states}


def load_scenario(path, sizes=None):
    return validate_scenario(json.loads(pathlib.Path(path).read_text()), sizes)


def scenario_snapshot(scenario):
    """Keep the evidence copy reusable as a scenario input, not internal tuples."""
    return {**scenario, "sizes": [size_name(size) for size in scenario["sizes"]],
            "states": [{**state, "sizes": [size_name(size) for size in state["sizes"]]} for state in scenario["states"]]}


class FrameFailure(Exception):
    pass


def frame_command(result, description):
    if result.returncode:
        raise FrameFailure(f"{description}: {(result.stderr or result.stdout).strip()}")
    return result


def frame_bash_running(report):
    state = report.get("work", {}).get("state", {})
    return state.get("kind") == "bash" and int(state.get("running", "0")) > 0


def frame_request(run, result, settle="answered", sid=None):
    frame_command(result, "Session message")
    match = re.search(r"request: (\S+)", result.stderr)
    if not match:
        raise FrameFailure("Session message returned no request handle")
    key = match.group(1)
    if settle == "pending":
        return
    deadline = time.monotonic() + 40
    while time.monotonic() < deadline:
        if settle == "stop":
            inspection = run.rui_cmd("session", "inspect", "--store", run.store, "--session", sid, log=False)
            # Public Session inspection exposes the live Bash call.
            if inspection.returncode == 0 and frame_bash_running(json.loads(inspection.stdout)):
                frame_command(run.rui_cmd("session", "stop", "--store", run.store, "--session", sid), "stop Session")
                settle = "answered"
        inspection = run.rui_cmd("request", "inspect", "--store", run.store, "--key", key, log=False)
        if inspection.returncode == 0:
            data = json.loads(inspection.stdout)
            status = data.get("observation", {}).get("state")
            if status in ("completed", "failed", "cancelled", "rejected"):
                if settle == "stop":
                    raise FrameFailure("Session settled before its Bash call could be stopped")
                return data
        time.sleep(0.1)
    raise FrameFailure(f"request {key} did not settle ({settle})")


def seed_cast(run, entries):
    for entry in cast_entries(entries):
        workspace = run.home / entry["workspace"]
        workspace.mkdir(parents=True, exist_ok=True)
        (workspace / "README.md").write_text("verify-rui project\n")
        (workspace / "src").mkdir(exist_ok=True)
        sid = None
        for i, text in enumerate(entry["messages"]):
            if sid is None:
                model = entry.get("model", "gpt-6.1-sol")
                argv = ["session", "start", "--store", run.store, "--workspace", workspace, "--provider", "codex",
                        "--model", model, "--permission-mode", entry["mode"], "--label", entry["label"]]
                if entry.get("effort"):
                    argv += ["--reasoning-effort", entry["effort"]]
                result = run.rui_cmd(*argv, input=text)
                if result.returncode and model != "gpt-5.5" and "[selection_model_unsupported]" in result.stderr:
                    refusal = result.stderr
                    argv[argv.index("--model") + 1] = "gpt-5.5"
                    result = run.rui_cmd(*argv, input=text)
                    print(f"verify-rui: {entry['label']}: {model} refused; using gpt-5.5", file=sys.stderr)
                    append_jsonl(run.evidence / "frames-model-fallback.jsonl", {"label": entry["label"], "requested": model,
                                                                             "used": "gpt-5.5", "refusal": refusal})
                frame_command(result, f"start {entry['label']}")
                sid = json.loads(result.stdout)["context"]["session"]
                run.meta["sessions"][entry["label"]] = sid
                atomic_write(run.root / "run.json", json.dumps(run.meta, indent=1) + "\n")
            else:
                result = run.rui_cmd("session", "send", "--store", run.store, "--to", sid, input=text)
            settle = entry.get("settle", "answered") if i == len(entry["messages"]) - 1 else "answered"
            frame_request(run, result, settle, sid)


def frame_pane(run, target):
    return frame_command(run.tmux("capture-pane", "-p", "-t", target, check=False), "capture pane").stdout


def frame_dead(run, target):
    return run.tmux("display-message", "-p", "-t", target, "#{pane_dead}", check=False).stdout.strip() != "0"


def frame_wait(run, target, text, absent=False, timeout=20, allow_exit=False):
    deadline = time.monotonic() + timeout
    while True:
        screen = frame_pane(run, target)
        if not allow_exit and frame_dead(run, target):
            raise FrameFailure("Rui exited before the state was reached")
        if (text in screen) != absent:
            return
        if time.monotonic() >= deadline:
            raise FrameFailure(f"timeout waiting for {'absence of ' if absent else ''}{text!r}")
        time.sleep(0.1)


def frame_steps(run, target, steps, exiting=False):
    for step in steps:
        if "text" in step:
            frame_command(run.tmux("send-keys", "-l", "-t", target, "--", step["text"], check=False), "type text")
            time.sleep(0.4)  # Separate paste-sized literal input from the submit key, as in d.sh.
            exiting = exiting or step["text"] == "/exit"
        elif "keys" in step:
            for key in step["keys"]:
                raw = KEYS[key]
                frame_command(run.tmux("send-keys", "-H", "-t", target, *[f"{b:02x}" for b in raw], check=False), "send keys")
                # Let a lone Escape expire before any following key can become Alt-key input.
                time.sleep(0.35 if key == "Esc" else 0.08)
        elif "wait" in step or "gone" in step:
            action = "wait" if "wait" in step else "gone"
            frame_wait(run, target, step[action], action == "gone", step.get("timeout", 20), exiting)
        elif "sleep" in step:
            time.sleep(step["sleep"])
        elif "send" in step:
            message = step["send"]
            sid = run.sid(message["to"])
            result = run.rui_cmd("session", "send", "--store", run.store, "--to", sid, input=message["text"])
            frame_request(run, result, "answered" if message.get("wait", True) else "pending", sid)
        elif step["host"] == "pause":
            frame_command(run.rui_cmd("host", "pause", "--store", run.store), "pause Host")
        else:
            launch_host(run)
        if not exiting and frame_dead(run, target):
            raise FrameFailure("Rui exited before the state was reached")
    return exiting


def frame_capture(run, target, out, state, size, reason):
    cols, rows = size
    name = size_name(size)
    stem = f"{state['name']}@{name}"
    files = {ext: f"{stem}.{ext}" for ext in ("txt", "ansi", "html")}
    ansi = frame_command(run.tmux("capture-pane", "-e", "-N", "-p", "-t", target, check=False), "capture ANSI").stdout
    # Derive text and HTML from this same snapshot: a second capture could
    # already show the next state while the first still satisfied its marker.
    plain = "\n".join(line.rstrip(" ") for line in ANSI_ESCAPE.sub("", ansi).split("\n"))
    missing = next((text for text in frame_expectations(state) if text not in plain), None)
    if missing is not None and reason is None:
        reason = f"state left before capture: {missing}"
    unexpected = next((text for text in frame_absences(state) if text in plain), None)
    if unexpected is not None and reason is None:
        reason = f"unexpected on screen: {unexpected}"
    info = run.tmux("display-message", "-p", "-t", target,
                    "#{cursor_x} #{cursor_y} #{cursor_flag}").stdout.split()
    cx, cy, visible = map(int, info)
    bg, fg = THEMES[state.get("theme", "night")]
    (out / files["txt"]).write_text(plain)
    (out / files["ansi"]).write_text(ansi)
    (out / files["html"]).write_text(ansi_page(ansi_render(ansi.removesuffix("\n"), bg, fg), bg, fg, cols, rows,
                                              (cx, cy) if visible else (-5, -5)))
    return {"name": state["name"], "size": name, "files": files, "status": "failed" if reason else "ok",
            "ok": not bool(reason), "reason": reason, "sha": run.meta["sha"], "note": state.get("note", "")}


def frames_index(out, frames, png):
    sections = []
    for frame in frames:
        caption = html.escape(f"{frame['name']} · {frame['size']}")
        files = frame["files"]
        links = " · ".join(f'<a href="{html.escape(path, quote=True)}">{ext}</a>' for ext, path in files.items())
        view = f'<img src="{files["png"]}" alt="{caption}">' if png and "png" in files else \
            f'<iframe title="{caption}" src="{files["html"]}"></iframe>' if "html" in files else ""
        sections.append(f'<section><h2>{caption}</h2><p>{html.escape(frame["note"])}</p>'
                        f'<p>{frame["status"]}: {html.escape(frame["reason"] or "")}</p><p>{links}</p>{view}</section>')
    (out / "frames.json").write_text(json.dumps(frames, indent=2) + "\n")
    (out / "index.html").write_text('<!doctype html><meta charset="utf-8"><title>Rui frames</title>'
                                    '<style>body{font:16px system-ui;background:#ddd;padding:20px}'
                                    'img{max-width:100%}iframe{width:100%;height:900px;border:0}</style>' + "\n".join(sections))


def cmd_frames(args):
    try:
        scenario = load_scenario(args.scenario, args.sizes)
        selected = set(args.only.split(",")) if args.only else {s["name"] for s in scenario["states"]}
        unknown = selected - {s["name"] for s in scenario["states"]}
        if unknown:
            raise ValueError("unknown states: " + ", ".join(sorted(unknown)))
    except (OSError, ValueError, TypeError) as error:
        die(str(error))
    if not shutil.which("tmux"):
        die("frames requires tmux")
    if not args.no_png:
        if not shutil.which("node"):
            die("frames requires node and Playwright; use --no-png")
        probe = subprocess.run(["node", str(HERE.with_name("frames_png.js")), "--check"], capture_output=True, text=True)
        if probe.returncode:
            die("frames requires node and Playwright with Chromium; use --no-png")
    # Keep the existing new command as the one run/fixture owner.
    output = io.StringIO()
    try:
        with contextlib.redirect_stdout(output):
            cmd_new(argparse.Namespace(sha=args.sha, seed=0, no_sessions=True, answers="realistic", label="frames",
                                       active_capacity=2, host_setenv=[]))
    except BaseException:
        # Even a partially initialized run must be torn down; cmd_new writes run.json first.
        candidates = sorted((CACHE / "runs").glob(f"*-{args.sha[:7]}-{os.getpid()}"))
        if candidates and not args.keep:
            with contextlib.redirect_stdout(sys.stderr):
                try:
                    cmd_cleanup(argparse.Namespace(run=str(candidates[-1]), no_export=True))
                except SystemExit:
                    pass
        raise
    run = Run(output.getvalue().strip())
    # Match the review's home-relative working directory even in the empty overview.
    run.project = run.home / "code/rui"
    run.project.mkdir(parents=True, exist_ok=True)
    (run.project / "README.md").write_text("verify-rui project\n")
    (run.project / "src").mkdir(exist_ok=True)
    run.meta["project"] = str(run.project)
    atomic_write(run.root / "run.json", json.dumps(run.meta, indent=1) + "\n")
    out = pathlib.Path(args.out).resolve() if args.out else run.evidence / "frames"
    records = []
    failed = False
    try:
        out.mkdir(parents=True, exist_ok=True)
        (out / "scenario.json").write_text(json.dumps(scenario_snapshot(scenario), indent=2) + "\n")
        # A keeper window preserves the private server and its options between states.
        run.tmux("-f", "/dev/null", "new-session", "-d", "-s", "frames", "-n", "keeper", "sleep 86400")
        run.own("tmux-server", int(run.tmux("display-message", "-p", "#{pid}").stdout), socket=str(run.sock))
        run.tmux("set-option", "-g", "remain-on-exit", "on")
        run.tmux("set-option", "-g", "escape-time", "0")
        run.tmux("set-option", "-g", "status", "off")
        last = max(i for i, state in enumerate(scenario["states"]) if state["name"] in selected)
        for state in scenario["states"][:last + 1]:
            state_sizes = state["sizes"]
            cols, rows = state_sizes[0]
            target = f"=frames:={state['name']}"
            reason = None
            opened = False
            failure_capture = None
            try:
                seed_cast(run, state.get("cast", []))
                bg, fg = THEMES[state.get("theme", "night")]
                run.tmux("set-option", "-g", "window-style", f"bg={bg},fg={fg}")
                run.tmux("set-option", "-g", "window-active-style", f"bg={bg},fg={fg}")
                env = run.env(**{"COLORTERM": "truecolor", **state.get("env", {})})
                argv = session_argv(run, state["open"])
                command = "exec env -i " + shlex.join([f"{k}={v}" for k, v in env.items()]) + " " + shlex.join(argv)
                # No client is attached: default-size sets the PTY before exec.
                # Resizing only after exec can lose SIGWINCH during Rui startup.
                run.tmux("set-option", "-g", "default-size", f"{cols}x{rows}")
                run.tmux("set-option", "-g", "window-size", "latest")
                run.tmux("new-window", "-d", "-t", "frames", "-n", state["name"], "-c", run.project, command)
                opened = True
                run.tmux("set-option", "-g", "window-size", "manual")
                run.tmux("resize-window", "-t", target, "-x", cols, "-y", rows)
                # An explicit Host-stopped diagnostic is an intentionally exited
                # surface, unlike an early exit in a normal interactive state.
                stopped_marker = next((step["wait"] for step in state["steps"]
                                       if "The Host stopped." in step.get("wait", "")), None)
                time.sleep(1.2)  # Rui's first composer precedes its opening transcript read.
                first_wait = state["steps"][0].get("wait") if state["steps"] else None
                frame_wait(run, target, first_wait or "›", allow_exit=bool(stopped_marker))
                frame_steps(run, target, state["steps"], exiting=bool(stopped_marker))
            except (Exception, SystemExit) as error:
                reason = str(error)
                if state["name"] in selected:
                    failed = True
                    print(f"verify-rui: {state['name']}: {reason}", file=sys.stderr)
                else:
                    print(f"verify-rui: warning: {state['name']}: {reason} "
                          "(not selected; its failure does not fail this run)", file=sys.stderr)
                if opened and state["name"] in selected:
                    try:
                        failure_capture = frame_capture(run, target, out, state, state_sizes[0], reason)
                    except (Exception, SystemExit):
                        pass  # The capture error below retains the primary state failure.
            try:
                if state["name"] in selected:
                    for index, size in enumerate(state_sizes):
                        if failure_capture and index == 0:
                            records.append(failure_capture)
                            continue
                        try:
                            if index > 0:
                                width, height = size
                                frame_command(run.tmux("resize-window", "-t", target, "-x", width, "-y", height, check=False), "resize window")
                                time.sleep(0.8)
                            # The first viewport is already sized. Capture directly
                            # after its steps/wait, while a transient is still visible.
                            record = frame_capture(run, target, out, state, size, reason)
                        except (Exception, SystemExit) as error:
                            failed = True
                            record = {"name": state["name"], "size": size_name(size), "files": {}, "status": "failed", "ok": False,
                                      "reason": reason or str(error), "sha": args.sha, "note": state.get("note", "")}
                        failed = failed or not record["ok"]
                        if not record["ok"] and reason is None:
                            print(f"verify-rui: {state['name']}@{record['size']}: {record['reason']}", file=sys.stderr)
                        records.append(record)
                    frames_index(out, records, False)
            finally:
                if opened:
                    run.tmux("kill-window", "-t", target, check=False)
        if not args.no_png:
            result = subprocess.run(["node", str(HERE.with_name("frames_png.js")), str(out)], capture_output=True, text=True)
            if result.returncode:
                failed = True
                print("verify-rui: PNG rendering failed: " + " ".join(result.stderr.strip().splitlines()), file=sys.stderr)
            for record in records:
                png = f"{record['name']}@{record['size']}.png"
                if (out / png).exists():
                    record["files"]["png"] = png
                elif "html" in record["files"]:
                    record.update(ok=False, status="failed", reason=record["reason"] or "PNG rendering failed")
        frames_index(out, records, not args.no_png)
    finally:
        if not args.keep:
            with contextlib.redirect_stdout(sys.stderr):
                try:
                    cmd_cleanup(argparse.Namespace(run=str(run.root), no_export=True))
                except SystemExit as error:
                    failed = failed or bool(error.code)
    print(out)
    if failed:
        raise SystemExit(1)


# ---------------------------------------------------------------- CLI


def main():
    parser = argparse.ArgumentParser(prog="verify-rui", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("build", help="build a pinned SHA once (ReleaseSafe) into the cache")
    p.add_argument("sha"); p.add_argument("--repo"); p.add_argument("--pkg-dir"); p.add_argument("--force", action="store_true")
    p.add_argument("--source", help="existing clean detached worktree of SHA (default: cache worktree)")
    p.add_argument("--no-screen", action="store_true", help="skip the committed-screen observer library")
    p.set_defaults(func=cmd_build)
    p = sub.add_parser("new", help="new run: synthetic HOME/Store, fixture provider, Host, Sessions demo(bypass)/approve(ask)")
    p.add_argument("sha"); p.add_argument("--seed", type=int, default=0, help="seed N answered messages into demo")
    p.add_argument("--no-sessions", action="store_true", help="an empty Store: start neither demo nor approve")
    p.add_argument("--active-capacity", type=int, default=2, help="the Host's Active Capacity")
    p.add_argument("--host-setenv", action="append", default=[], metavar="NAME=VALUE",
                   help="add one variable to the Host's own environment (e.g. a Host-only secret)")
    p.add_argument("--label", default="")
    p.add_argument("--answers", choices=["realistic", "echo"], default="echo")
    p.set_defaults(func=cmd_new)
    p = sub.add_parser("frames", help="render named screen states to text, HTML and PNG without a screen library")
    p.add_argument("sha")
    p.add_argument("--scenario", default=str(HERE.with_name("frames.json")))
    p.add_argument("--only", metavar="NAME,...")
    p.add_argument("--sizes", metavar="WxH,...")
    p.add_argument("--out")
    p.add_argument("--no-png", action="store_true")
    p.add_argument("--keep", action="store_true")
    p.set_defaults(func=cmd_frames)
    p = sub.add_parser("restart-host", help="stop the run's Host and start a fresh one on the same Store and fixture")
    p.add_argument("run")
    p.set_defaults(func=cmd_restart_host)

    p = sub.add_parser("doctor", help="read-only: right binary/SHA, owned Host ready, owned fixture, private tmux")
    p.add_argument("run"); p.add_argument("--expect-sha")
    p.set_defaults(func=cmd_doctor)
    p = sub.add_parser("term", help="open a Rui terminal: pty | tmux-detached | tmux-attached")
    p.add_argument("run"); p.add_argument("name")
    p.add_argument("--surface", choices=["pty", "tmux-detached", "tmux-attached"], required=True)
    p.add_argument("--session", default="demo", help="demo | approve | overview (bare rui) | a Session ID")
    p.add_argument("--size", default="80x24")
    p.add_argument("--no-tap", action="store_true", help="tmux only: run Rui directly in the pane (control; no byte log)")
    p.add_argument("--setenv", action="append", default=[], metavar="NAME=VALUE",
                   help="add or replace one variable in this terminal's environment; PATH's value may hold {PATH} for the run's PATH")
    p.add_argument("argv", nargs="*", help="override argv (must still pass --store)")
    p.set_defaults(func=cmd_term)
    p = sub.add_parser("send", help="inject input: --text, --hex or --keys; logged with monotonic time")
    p.add_argument("run"); p.add_argument("name")
    group = p.add_mutually_exclusive_group(required=True)
    group.add_argument("--text"); group.add_argument("--hex"); group.add_argument("--keys", nargs="+", choices=sorted(KEYS))
    p.add_argument("--via", choices=["fifo", "tmux", "client"], help="default: fifo for pty, tmux send-keys for tmux panes")
    p.set_defaults(func=cmd_send)
    p = sub.add_parser("signal", help="send INT or TERM to the Rui process of a terminal (verified ownership)")
    p.add_argument("run"); p.add_argument("name"); p.add_argument("signal", choices=["INT", "TERM", "HUP"])
    p.set_defaults(func=cmd_signal)
    p = sub.add_parser("wait", help="wait for a committed frame containing MARKER")
    p.add_argument("run"); p.add_argument("name"); p.add_argument("--marker", required=True)
    p.add_argument("--absent"); p.add_argument("--composer", action="store_true"); p.add_argument("--after", type=int)
    p.add_argument("--timeout", type=float, default=15); p.add_argument("--allow-exit", action="store_true")
    p.set_defaults(func=cmd_wait)
    p = sub.add_parser("screen", help="print/save the committed frame (+ tmux capture-pane and pane flags)")
    p.add_argument("run"); p.add_argument("name"); p.add_argument("--label")
    p.set_defaults(func=cmd_screen)
    p = sub.add_parser("rui", help="run a one-shot Rui command with this run's HOME (requires --store)")
    p.add_argument("run"); p.add_argument("argv", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_rui)
    p = sub.add_parser("evidence", help="export Store/capture facts and build timeline.txt / summary.json")
    p.add_argument("run")
    p.set_defaults(func=cmd_evidence)
    p = sub.add_parser("journey", help="scripted compose-submit journey (the proof run)")
    p.add_argument("run"); p.add_argument("name")
    p.add_argument("--surface", choices=["pty", "tmux-detached", "tmux-attached"], default="tmux-detached")
    p.add_argument("--size", default="80x24"); p.add_argument("--text", default="Hello from verify-rui")
    p.set_defaults(func=cmd_journey)
    p = sub.add_parser("replay", help="replay a terminal's received input bytes (original timing) into a new PTY terminal")
    p.add_argument("run"); p.add_argument("source"); p.add_argument("name"); p.add_argument("--from-run")
    p.add_argument("--session", default="demo"); p.add_argument("--size", default="80x24")
    p.add_argument("--skip-reports", action="store_true", help="drop DECRPM terminal replies from the replay")
    p.set_defaults(func=cmd_replay)
    p = sub.add_parser("gui", help="write (and --open) a Terminal.app attach script for physical keys/wheel")
    p.add_argument("run"); p.add_argument("name"); p.add_argument("--open", action="store_true")
    p.add_argument("--app", default="Terminal")
    p.set_defaults(func=cmd_gui)
    p = sub.add_parser("physical", help="guided ~5-minute physical keys/wheel/consent session, auto-graded (or --rehearse)")
    p.add_argument("sha"); p.add_argument("--rehearse", action="store_true", help="synthetic input; validates tooling only")
    p.add_argument("--rehearse-omit", nargs="+", metavar="STEP", help="rehearsal negative control: skip these steps' input")
    p.add_argument("--app", default="Terminal"); p.add_argument("--no-tmux", action="store_true")
    p.add_argument("--keep", action="store_true", help="skip cleanup at the end")
    p.add_argument("--smoke", action="store_true", help="open the owned GUI windows, reach the composer, SIGTERM; no input")
    p.set_defaults(func=cmd_physical)
    p = sub.add_parser("_coach-view")
    p.add_argument("run")
    p.set_defaults(func=cmd_coach_view)
    p = sub.add_parser("cleanup", help="stop owned processes/tmux server; archive Store; keep evidence")
    p.add_argument("run"); p.add_argument("--no-export", action="store_true")
    p.set_defaults(func=cmd_cleanup)
    p = sub.add_parser("list", help="list runs")
    p.set_defaults(func=cmd_list)
    p = sub.add_parser("_tap")
    p.add_argument("term_dir"); p.add_argument("--source", required=True); p.add_argument("--cwd", required=True)
    p.add_argument("--env", required=True); p.add_argument("--size", default="80x24")
    p.add_argument("--mode", choices=["terminal", "fifo"], required=True); p.add_argument("--hold", action="store_true")
    p.add_argument("argv", nargs="+")
    p.set_defaults(func=tap_main)
    p = sub.add_parser("_fixture")
    p.add_argument("run")
    p.set_defaults(func=fixture_main)
    args = parser.parse_args()
    if args.command in ("_tap",) and args.argv and args.argv[0] == "--":
        args.argv = args.argv[1:]
    if args.command == "term" and args.argv and args.argv[0] == "--":
        args.argv = args.argv[1:]
    args.func(args)


if __name__ == "__main__":
    main()
