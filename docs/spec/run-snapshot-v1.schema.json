{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepage.invalid/schema/run-snapshot-v1.json",
  "title": "OnePage RunSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "run",
    "job_summary",
    "interaction_requests",
    "output",
    "failure",
    "uncertainties"
  ],
  "properties": {
    "api_version": {
      "const": "onepage.run-snapshot.v1"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "job_summary": {
      "$ref": "#/$defs/job_summary"
    },
    "interaction_requests": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/permission_request"
          },
          {
            "$ref": "#/$defs/input_request"
          }
        ]
      }
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "job_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Caller-defined Job Key: 1-128 Unicode scalar values and at most 512 UTF-8 bytes. The byte bound and rejection of lone surrogates are enforced by the production decoder."
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded_text": {
      "type": "string",
      "maxLength": 65536
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "revision",
        "state",
        "cancellation_requested",
        "workflow_semantics_identity",
        "source_digest",
        "arguments_digest",
        "workspace_identity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaque_id"
        },
        "key": {
          "$ref": "#/$defs/opaque_id"
        },
        "revision": {
          "$ref": "#/$defs/decimal_string"
        },
        "state": {
          "enum": [
            "running",
            "input_required",
            "suspended",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "cancellation_requested": {
          "type": "boolean"
        },
        "workflow_semantics_identity": {
          "$ref": "#/$defs/digest"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "arguments_digest": {
          "$ref": "#/$defs/digest"
        },
        "workspace_identity": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "job_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "pending",
        "running",
        "input_required",
        "in_flight",
        "completed",
        "failed",
        "cancelled",
        "indeterminate"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "running": { "type": "integer", "minimum": 0 },
        "input_required": { "type": "integer", "minimum": 0 },
        "in_flight": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 },
        "indeterminate": { "type": "integer", "minimum": 0 }
      }
    },
    "job_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "recent", "cursor"],
      "properties": {
        "counts": {
          "$ref": "#/$defs/job_counts"
        },
        "recent": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/job"
          }
        },
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/opaque_id" }
          ]
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "state", "session_id"],
      "properties": {
        "id": { "$ref": "#/$defs/opaque_id" },
        "key": { "$ref": "#/$defs/job_key" },
        "state": {
          "enum": [
            "pending",
            "running",
            "input_required",
            "in_flight",
            "completed",
            "failed",
            "cancelled",
            "indeterminate"
          ]
        },
        "session_id": { "$ref": "#/$defs/opaque_id" }
      }
    },
    "runtime_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "job_id"],
      "properties": {
        "type": { "const": "runtime" },
        "job_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "agent_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "job_id"],
      "properties": {
        "type": { "const": "agent" },
        "job_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id"],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "permission_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "kind",
        "origin",
        "recipient",
        "created_revision",
        "status",
        "prompt",
        "operation",
        "descriptor",
        "allowed_options",
        "required_authority"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/opaque_id" },
        "kind": { "const": "permission" },
        "origin": { "$ref": "#/$defs/runtime_origin" },
        "recipient": { "$ref": "#/$defs/recipient" },
        "created_revision": { "$ref": "#/$defs/decimal_string" },
        "status": { "const": "open" },
        "prompt": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/content_part" }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "generation"],
          "properties": {
            "kind": { "$ref": "#/$defs/opaque_id" },
            "id": { "$ref": "#/$defs/opaque_id" },
            "generation": { "$ref": "#/$defs/decimal_string" }
          }
        },
        "descriptor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "byte_length", "summary", "content"],
          "properties": {
            "digest": { "$ref": "#/$defs/digest" },
            "byte_length": { "$ref": "#/$defs/decimal_string" },
            "summary": { "$ref": "#/$defs/workflow_value" },
            "content": {
              "oneOf": [
                { "$ref": "#/$defs/inline_text" },
                { "$ref": "#/$defs/content_ref" }
              ]
            }
          }
        },
        "allowed_options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["allow_once", "deny"]
          }
        },
        "required_authority": { "$ref": "#/$defs/opaque_id" }
      }
    },
    "input_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "kind",
        "origin",
        "recipient",
        "created_revision",
        "status",
        "prompt",
        "response_shape"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/opaque_id" },
        "kind": { "const": "input" },
        "origin": { "$ref": "#/$defs/agent_origin" },
        "recipient": { "$ref": "#/$defs/recipient" },
        "created_revision": { "$ref": "#/$defs/decimal_string" },
        "status": { "const": "open" },
        "prompt": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/content_part" }
        },
        "response_shape": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "max_bytes"],
              "properties": {
                "type": { "const": "text" },
                "max_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "options"],
              "properties": {
                "type": { "const": "single_choice" },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "label"],
                    "properties": {
                      "id": { "$ref": "#/$defs/opaque_id" },
                      "label": { "type": "string", "maxLength": 1024 }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts", "artifacts"],
      "properties": {
        "parts": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/content_part" }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "content_part": {
      "oneOf": [
        { "$ref": "#/$defs/inline_text" },
        { "$ref": "#/$defs/inline_json" },
        { "$ref": "#/$defs/content_ref" }
      ]
    },
    "inline_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "inline_text" },
        "text": { "$ref": "#/$defs/bounded_text" }
      }
    },
    "inline_json": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "inline_json" },
        "value": { "$ref": "#/$defs/workflow_value" }
      }
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "media_type", "byte_length", "digest", "preview"],
      "properties": {
        "type": { "const": "content_ref" },
        "ref": { "$ref": "#/$defs/opaque_id" },
        "media_type": { "type": "string", "maxLength": 255 },
        "byte_length": { "$ref": "#/$defs/decimal_string" },
        "digest": { "$ref": "#/$defs/digest" },
        "preview": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/bounded_text" }
          ]
        }
      }
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "name", "kind", "parts"],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/opaque_id" },
            "name": { "type": "string", "maxLength": 1024 },
            "kind": { "const": "blob" },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "$ref": "#/$defs/content_part" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "name",
            "kind",
            "relative_path",
            "before_digest",
            "after_digest",
            "parts"
          ],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/opaque_id" },
            "name": { "type": "string", "maxLength": 1024 },
            "kind": { "const": "workspace_change" },
            "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "before_digest": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/digest" }
              ]
            },
            "after_digest": { "$ref": "#/$defs/digest" },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "$ref": "#/$defs/content_part" }
            }
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "message", "diagnostic_refs"],
      "properties": {
        "class": { "$ref": "#/$defs/opaque_id" },
        "message": { "$ref": "#/$defs/bounded_text" },
        "diagnostic_refs": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/content_ref" }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "attempt_id", "kind", "disposition", "summary", "content"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/opaque_id" },
        "attempt_id": { "$ref": "#/$defs/opaque_id" },
        "kind": { "$ref": "#/$defs/opaque_id" },
        "disposition": { "const": "possibly_executed" },
        "summary": { "$ref": "#/$defs/bounded_text" },
        "content": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/content_ref" }
          ]
        }
      }
    },
    "workflow_value": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string", "maxLength": 65536 },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "number",
          "not": { "type": "integer" }
        },
        {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/workflow_value" }
        },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/workflow_value" }
        }
      ]
    }
  }
}
