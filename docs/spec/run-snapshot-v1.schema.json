{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepage.invalid/schema/run-snapshot-v1.json",
  "title": "OnePage RunSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "run",
    "turn_memberships",
    "interaction_requests",
    "output",
    "failure",
    "uncertainties"
  ],
  "properties": {
    "api_version": {
      "const": "onepage.run-snapshot.v1"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "turn_memberships": {
      "$ref": "#/$defs/turn_membership_collection"
    },
    "interaction_requests": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/permission_request"
          },
          {
            "$ref": "#/$defs/input_request"
          }
        ]
      }
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "agent_call_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Caller-defined Agent Call Key: 1-128 Unicode scalar values and at most 512 UTF-8 bytes. The byte bound and rejection of lone surrogates are enforced by the production decoder."
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded_text": {
      "type": "string",
      "maxLength": 65536
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "revision",
        "state",
        "cancellation_requested",
        "workflow_semantics_identity",
        "source_digest",
        "arguments_digest",
        "workspace_identity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/opaque_id"
        },
        "key": {
          "$ref": "#/$defs/opaque_id"
        },
        "revision": {
          "$ref": "#/$defs/decimal_string"
        },
        "state": {
          "enum": [
            "running",
            "input_required",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "cancellation_requested": {
          "type": "boolean"
        },
        "workflow_semantics_identity": {
          "$ref": "#/$defs/digest"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "arguments_digest": {
          "$ref": "#/$defs/digest"
        },
        "workspace_identity": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "turn_counts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Counts partition every Turn in the Run by its derived current condition or terminal outcome.",
      "required": [
        "total",
        "runnable",
        "waiting_for_input",
        "in_flight",
        "completed",
        "failed",
        "cancelled"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "runnable": { "type": "integer", "minimum": 0 },
        "waiting_for_input": { "type": "integer", "minimum": 0 },
        "in_flight": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 }
      }
    },
    "turn_membership_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "recent", "cursor"],
      "properties": {
        "counts": {
          "$ref": "#/$defs/turn_counts"
        },
        "recent": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/turn_membership"
          }
        },
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/opaque_id" }
          ]
        }
      }
    },
    "turn_membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "agent_call_key", "condition", "session_id"],
      "properties": {
        "turn_id": { "$ref": "#/$defs/opaque_id" },
        "agent_call_key": { "$ref": "#/$defs/agent_call_key" },
        "condition": {
          "description": "Derived with this precedence: terminal outcome; unresolved admitted external attempt; open request with no remaining progress; otherwise runnable. No independent lifecycle value is persisted.",
          "enum": [
            "runnable",
            "waiting_for_input",
            "in_flight",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "session_id": { "$ref": "#/$defs/opaque_id" }
      }
    },
    "runtime_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "turn_id"],
      "properties": {
        "type": { "const": "runtime" },
        "turn_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "agent_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "turn_id", "operation_id"],
      "properties": {
        "type": { "const": "agent" },
        "turn_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "operation_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id"],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "permission_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "kind",
        "origin",
        "recipient",
        "created_revision",
        "status",
        "prompt",
        "operation",
        "descriptor",
        "allowed_options",
        "required_authority"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/opaque_id" },
        "kind": { "const": "permission" },
        "origin": { "$ref": "#/$defs/runtime_origin" },
        "recipient": { "$ref": "#/$defs/recipient" },
        "created_revision": { "$ref": "#/$defs/decimal_string" },
        "status": { "const": "open" },
        "prompt": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/content_part" }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "$ref": "#/$defs/opaque_id" },
            "id": { "$ref": "#/$defs/opaque_id" }
          }
        },
        "descriptor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "byte_length", "summary", "content"],
          "properties": {
            "digest": { "$ref": "#/$defs/digest" },
            "byte_length": { "$ref": "#/$defs/decimal_string" },
            "summary": { "$ref": "#/$defs/workflow_value" },
            "content": {
              "oneOf": [
                { "$ref": "#/$defs/inline_text" },
                { "$ref": "#/$defs/content_ref" }
              ]
            }
          }
        },
        "allowed_options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["allow_once", "deny"]
          }
        },
        "required_authority": { "$ref": "#/$defs/opaque_id" }
      }
    },
    "input_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "kind",
        "origin",
        "recipient",
        "created_revision",
        "status",
        "prompt",
        "response_shape"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/opaque_id" },
        "kind": { "const": "input" },
        "origin": { "$ref": "#/$defs/agent_origin" },
        "recipient": { "$ref": "#/$defs/recipient" },
        "created_revision": { "$ref": "#/$defs/decimal_string" },
        "status": { "const": "open" },
        "prompt": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/content_part" }
        },
        "response_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "max_bytes"],
          "properties": {
            "type": { "const": "text" },
            "max_bytes": { "type": "integer", "minimum": 1, "maximum": 4096 }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts"],
      "properties": {
        "parts": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/content_part" }
        }
      }
    },
    "content_part": {
      "oneOf": [
        { "$ref": "#/$defs/inline_text" },
        { "$ref": "#/$defs/inline_json" },
        { "$ref": "#/$defs/content_ref" }
      ]
    },
    "inline_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "inline_text" },
        "text": { "$ref": "#/$defs/bounded_text" }
      }
    },
    "inline_json": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "inline_json" },
        "value": { "$ref": "#/$defs/workflow_value" }
      }
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "media_type", "byte_length", "digest", "preview"],
      "properties": {
        "type": { "const": "content_ref" },
        "ref": { "$ref": "#/$defs/opaque_id" },
        "media_type": { "type": "string", "maxLength": 255 },
        "byte_length": { "$ref": "#/$defs/decimal_string" },
        "digest": { "$ref": "#/$defs/digest" },
        "preview": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/bounded_text" }
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "message", "diagnostic_refs"],
      "properties": {
        "class": { "$ref": "#/$defs/opaque_id" },
        "message": { "$ref": "#/$defs/bounded_text" },
        "diagnostic_refs": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/content_ref" }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "attempt_id", "kind", "disposition", "summary", "content"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/opaque_id" },
        "attempt_id": { "$ref": "#/$defs/opaque_id" },
        "kind": { "$ref": "#/$defs/opaque_id" },
        "disposition": { "const": "possibly_executed" },
        "summary": { "$ref": "#/$defs/bounded_text" },
        "content": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/content_ref" }
          ]
        }
      }
    },
    "workflow_value": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string", "maxLength": 65536 },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "number",
          "not": { "type": "integer" }
        },
        {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/workflow_value" }
        },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/workflow_value" }
        }
      ]
    }
  }
}
