{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepage.invalid/schema/interaction-response-batch-v1.json",
  "title": "OnePage InteractionResponseBatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "responses"],
  "properties": {
    "api_version": {
      "const": "onepage.interaction-response-batch.v1"
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/permission_response" },
          { "$ref": "#/$defs/text_input_response" }
        ]
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "permission_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "kind", "decision", "descriptor_digest"],
      "properties": {
        "request_id": { "$ref": "#/$defs/opaque_id" },
        "kind": { "const": "permission" },
        "decision": {
          "enum": ["allow_once", "deny"]
        },
        "descriptor_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "text_input_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "kind", "response"],
      "properties": {
        "request_id": { "$ref": "#/$defs/opaque_id" },
        "kind": { "const": "input" },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": {
              "type": "string",
              "maxLength": 4096,
              "description": "The Run Service additionally enforces the matching open request's max_bytes limit over canonical UTF-8."
            }
          }
        }
      }
    }
  }
}
