+
+test "pending list burst waits for each delivered focus and cursor frame" {
+    const held = try HeldFrontend.create();
+    defer held.destroy();
+    const self = &held.self;
+    self.init.gpa = std.testing.allocator;
+    self.queue.observe(.{ .boundary = 12, .queued = .{ .count = 3, .oldest_position = 2, .newest_position = 4, .newest_admission = 12 } });
+    const request = self.queue.wanted.?;
+    self.queue.wanted = null;
+    var page: reads.QueuePage = .{ .len = 3 };
+    for (0..3) |index| {
+        page.entries[index] = .{ .admission = 10 + @as(u64, @intCast(index)), .position = 2 + @as(u64, @intCast(index)), .line = .{} };
+        try page.entries[index].line.set("duplicate");
+    }
+    try std.testing.expect(self.queue.publish(request, page));
+    try held.settle();
+    try std.testing.expect(self.queue.visible and !self.queue.focused);
+    const burst = "\x1bq\x1b[B\x1b[B";
+    try std.testing.expectEqual(@as(isize, burst.len), std.c.write(held.pipes[0][1], burst.ptr, burst.len));
+    const PumpToStale = struct {
+        fn run(front: *Self) !void {
+            for (0..32) |_| {
+                const service = try front.step(0);
+                if (front.terminal.screen.stale()) return;
+                if (service != .byte) return error.TestUnexpectedResult;
+            }
+            return error.TestUnexpectedResult;
+        }
+    };
+    var text: [512]u8 = undefined;
+    // The first input can focus, but the first arrow remains unread until
+    // the selected row and its focus hint have actually been delivered.
+    try PumpToStale.run(self);
+    try std.testing.expect(self.queue.focused and !self.queue.visible);
+    try std.testing.expectEqual(@as(usize, 0), self.queue.list.cursor);
+    const first = held.screen.ticket.?.frame;
+    try held.settle();
+    try std.testing.expect(held.screen.ticket.?.delivered and held.screen.ticket.?.frame > first);
+    try std.testing.expect(rowWith(held.screen, "› 10 duplicate", &text) != null);
+    // Each arrow likewise invalidates that exact frame before another arrow.
+    try PumpToStale.run(self);
+    try std.testing.expectEqual(@as(usize, 1), self.queue.list.cursor);
+    try std.testing.expect(!self.queue.visible);
+    const second = held.screen.ticket.?.frame;
+    try held.settle();
+    try std.testing.expect(held.screen.ticket.?.delivered and held.screen.ticket.?.frame > second);
+    try std.testing.expect(rowWith(held.screen, "› 11 duplicate", &text) != null);
+    try PumpToStale.run(self);
+    try std.testing.expectEqual(@as(usize, 2), self.queue.list.cursor);
+    try std.testing.expect(!self.queue.visible);
+    try held.settle();
+    try std.testing.expect(rowWith(held.screen, "› 12 duplicate", &text) != null);
+    try std.testing.expectEqualStrings("", self.input.composition().bytes);
+    try std.testing.expect(self.submission.view() == null and held.screen.consent == null);
+}
