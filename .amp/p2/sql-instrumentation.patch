@@ -0,0 +1,24 @@
+/* Measurement-only SQLite entry tracing; never part of the product patch. */
+#include <sqlite3.h>
+#include <stdio.h>
+
+static int p2_statement(unsigned event, void *context, void *statement, void *detail) {
+    (void)event;
+    (void)context;
+    (void)detail;
+    const char *sql = sqlite3_sql((sqlite3_stmt *)statement);
+    if (sql) fprintf(stderr, "P2_SQL\t%s\n", sql);
+    return 0;
+}
+
+static int p2_open(sqlite3 *db, char **error, const sqlite3_api_routines *api) {
+    (void)error;
+    (void)api;
+    return sqlite3_trace_v2(db, SQLITE_TRACE_STMT, p2_statement, NULL);
+}
+
+__attribute__((constructor)) static void p2_initialize(void) {
+    if (sqlite3_auto_extension((void (*)(void))p2_open) != SQLITE_OK) {
+        fputs("P2_SQL_REGISTRATION_FAILED\n", stderr);
+    }
+}
