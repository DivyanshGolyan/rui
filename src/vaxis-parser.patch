+/// xterm modifyOtherKeys, CSI 27 ; modifier ; code ~, which some terminals
+/// (Ghostty's legacy Enter table) send without being asked. The modifier is
+/// 1 + (Shift 1 | Alt 2 | Ctrl 4 | Meta 8), unlike Kitty's mask, and the code
+/// is the key's Unicode scalar. It is a press with no associated text.
+fn parseModifiedKey(fields: *std.mem.SplitIterator(u8, .scalar), n: usize) Result {
+    const null_event: Result = .{ .event = null, .n = n };
+    const modifier_buf = fields.next() orelse return null_event;
+    const code_buf = fields.next() orelse return null_event;
+    if (fields.next() != null) return null_event;
+    const modifier = parseParam(u8, modifier_buf, null) orelse return null_event;
+    if (modifier < 1 or modifier > 16) return null_event;
+    const code = parseParam(u21, code_buf, null) orelse return null_event;
+    if (code > 0x10FFFF or (code >= 0xD800 and code <= 0xDFFF)) return null_event;
+    const mask = modifier - 1;
+    return .{
+        .event = .{ .key_press = .{
+            .codepoint = code,
+            .mods = .{ .shift = mask & 1 != 0, .alt = mask & 2 != 0, .ctrl = mask & 4 != 0, .meta = mask & 8 != 0 },
+        } },
+        .n = n,
+    };
+}
