+    pub fn next(self: *PagedGraphemeIterator) !?Grapheme {
+        const value = self.inner.nextGrapheme();
+        if (self.reader.failure) |err| return err;
+        if (value) |g| return .{ .start = g.start, .len = g.end - g.start };
+        return null;
+    }
+};
