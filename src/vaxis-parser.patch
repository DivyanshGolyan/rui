+fn visualGrapheme(reader: *vaxis.unicode.PagedReader, span: vaxis.unicode.Grapheme, scratch: *[max_cell_grapheme_bytes]u8) ![]const u8 {
+    if (span.len > max_cell_grapheme_bytes) return "�";
+    for (0..span.len) |i| scratch[i] = (try reader.readByte(span.start + i)) orelse return error.InvalidSourceRead;
