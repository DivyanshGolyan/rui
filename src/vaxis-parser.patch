+/// must be zero or a previously returned grapheme boundary.
+pub const PagedGraphemeIterator = struct {
+    reader: *PagedReader,
+    inner: uucode.grapheme.Iterator(PagedCodepoints),
+
+    pub fn init(reader: *PagedReader, start: usize) !PagedGraphemeIterator {
+        if (start > reader.source.length) return error.InvalidSourceOffset;
+        reader.failure = null;
+        const inner = uucode.grapheme.Iterator(PagedCodepoints).init(.{ .i = start, .reader = reader });
+        if (reader.failure) |err| return err;
+        return .{ .reader = reader, .inner = inner };
+    }
