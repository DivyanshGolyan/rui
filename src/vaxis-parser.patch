+                try testing.expectEqual(@as(usize, 128), text.len);
+                var expected: [128]u8 = undefined;
+                for (0..32) |i| @memcpy(expected[i * 4 ..][0..4], "😀");
+                try testing.expectEqualSlices(u8, &expected, text);
+            }
+        }
+    }
+}
