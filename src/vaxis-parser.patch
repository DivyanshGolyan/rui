+/// A decimal Unicode scalar value: no surrogate, nothing past U+10FFFF.
+fn parseScalar(buf: []const u8) ?u21 {
+    const cp = parseDecimal(u21, buf) orelse return null;
+    if (cp > 0x10ffff or (cp >= 0xd800 and cp <= 0xdfff)) return null;
+    return cp;
