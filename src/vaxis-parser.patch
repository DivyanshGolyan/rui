+        for (0..3) |boundary| {
+            var bytes: [256]u8 = undefined;
+            var out = std.Io.Writer.fixed(&bytes);
+            try out.writeAll("\x1b[1;1;");
+            for (0..31) |_| try out.writeAll("128512:");
+            // 128 bytes fits; a scalar beginning at 128 or spanning 127..129
+            // must reject the complete event, never publish a partial key.
+            try out.writeAll(if (boundary == 2) "97:97:97:233" else "128512");
+            if (boundary == 1) try out.writeAll(":97");
+            try out.writeByte(final);
+            const input = out.buffered();
+            const result = try parser.parse(input, null);
+            try testing.expectEqual(input.len, result.n);
+            if (boundary != 0) {
+                try testing.expect(result.event == null);
+            } else {
