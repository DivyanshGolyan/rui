+/// A reloadable UTF-8 source. The callback may return a short nonzero read;
+/// it must never return more than the supplied buffer. Source and callback
+/// remain alive while a PagedReader or its iterators borrow them.
+pub const PagedSource = struct {
+    userdata: *const anyopaque,
+    length: usize,
+    readFn: *const fn (*const anyopaque, u64, []u8) anyerror!usize,
+};
+
+/// Fixed-size source cache used by the native grapheme state machine. An
+/// iterator reports source errors, rather than treating a short read as EOF.
+pub const PagedReader = struct {
+    source: PagedSource,
+    buffer: [4096]u8 = undefined,
+    start: usize = 0,
+    count: usize = 0,
+    failure: ?anyerror = null,
+
+    /// Read one source byte, preserving source failures separately from EOF.
+    pub fn readByte(self: *PagedReader, at: usize) !?u8 {
+        const result = self.byteAt(at);
+        if (self.failure) |err| return err;
+        return result;
+    }
+
+    fn byteAt(self: *PagedReader, at: usize) ?u8 {
+        if (self.failure != null or at >= self.source.length) return null;
+        if (at < self.start or at - self.start >= self.count) {
+            self.start = at;
+            const wanted = @min(self.buffer.len, self.source.length - at);
+            self.count = self.source.readFn(self.source.userdata, at, self.buffer[0..wanted]) catch |err| {
+                self.failure = err;
+                return null;
+            };
+            if (self.count == 0 or self.count > wanted) {
+                self.failure = error.InvalidSourceRead;
+                return null;
+            }
+        }
+        return self.buffer[at - self.start];
+    }
+};
+
+const PagedCodepoints = struct {
+    i: usize,
+    reader: *PagedReader,
+
+    pub fn next(self: *@This()) ?u21 {
+        const first = self.reader.byteAt(self.i) orelse return null;
+        const count = std.unicode.utf8ByteSequenceLength(first) catch {
+            self.reader.failure = error.InvalidUtf8;
+            return null;
+        };
+        if (count > self.reader.source.length - self.i) {
+            self.reader.failure = error.InvalidUtf8;
+            return null;
+        }
+        var bytes: [4]u8 = undefined;
+        bytes[0] = first;
+        for (1..count) |i| {
+            bytes[i] = self.reader.byteAt(self.i + i) orelse {
+                if (self.reader.failure == null) self.reader.failure = error.InvalidUtf8;
+                return null;
+            };
+        }
+        const scalar = std.unicode.utf8Decode(bytes[0..count]) catch {
+            self.reader.failure = error.InvalidUtf8;
+            return null;
+        };
+        self.i += count;
+        return scalar;
+    }
+};
