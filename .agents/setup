#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
zig_version=0.16.0
go_version=1.27.1
local_bin="$HOME/.local/bin"
local_opt="$HOME/.local/opt"

step() {
    printf '\n==> %s\n' "$1"
}

install_system_packages() {
    local packages=(
        bash
        build-essential
        ca-certificates
        curl
        git
        make
        perl
        pkg-config
        python3
        xz-utils
    )
    local missing=()
    local package
    for package in "${packages[@]}"; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q '^install ok installed$'; then
            missing+=("$package")
        fi
    done
    if ((${#missing[@]} == 0)); then
        printf 'System packages already installed.\n'
        return
    fi

    local apt=(apt-get)
    if ((EUID != 0)); then
        command -v sudo >/dev/null || {
            printf 'Missing sudo; cannot install: %s\n' "${missing[*]}" >&2
            return 1
        }
        apt=(sudo apt-get)
    fi
    "${apt[@]}" update
    DEBIAN_FRONTEND=noninteractive "${apt[@]}" install -y --no-install-recommends "${missing[@]}"
}

download_verified() {
    local url=$1
    local expected=$2
    local destination=$3
    curl --fail --location --retry 3 --silent --show-error "$url" --output "$destination"
    printf '%s  %s\n' "$expected" "$destination" | sha256sum --check --status
}

fetch_zig_dependency() {
    local url=$1
    local expected=$2
    local filename=$3
    if [[ -f "$zig_cache/p/$expected.tar.gz" ]]; then
        printf 'Zig dependency %s already cached.\n' "$filename"
        return
    fi

    curl --fail --location --retry 3 --silent --show-error \
        "$url" \
        --output "$dependency_downloads/$filename"
    local actual
    actual="$(zig fetch --global-cache-dir "$zig_cache" "$dependency_downloads/$filename")"
    [[ "$actual" == "$expected" ]]
}

install_zig() (
    if [[ -x "$local_bin/zig" ]] && [[ "$($local_bin/zig version)" == "$zig_version" ]]; then
        printf 'Zig %s already installed.\n' "$zig_version"
        return
    fi

    local archive_arch checksum
    case "$(uname -m)" in
        x86_64)
            archive_arch=x86_64
            checksum=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
            ;;
        aarch64 | arm64)
            archive_arch=aarch64
            checksum=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
            ;;
        *)
            printf 'Unsupported Linux architecture for Zig: %s\n' "$(uname -m)" >&2
            return 1
            ;;
    esac

    local temporary archive extracted destination
    temporary="$(mktemp -d)"
    trap 'rm -rf "$temporary"' EXIT
    archive="$temporary/zig.tar.xz"
    extracted="$temporary/zig-$archive_arch-linux-$zig_version"
    destination="$local_opt/zig-$zig_version"
    download_verified \
        "https://ziglang.org/download/$zig_version/zig-$archive_arch-linux-$zig_version.tar.xz" \
        "$checksum" \
        "$archive"
    tar -xJf "$archive" -C "$temporary"
    rm -rf "$destination"
    mv "$extracted" "$destination"
    ln -sfn "$destination/zig" "$local_bin/zig"
)

install_go() (
    if [[ -x "$local_bin/go" ]] && [[ "$($local_bin/go version)" == "go version go$go_version "* ]]; then
        printf 'Go %s already installed.\n' "$go_version"
        return
    fi

    local archive_arch checksum
    case "$(uname -m)" in
        x86_64)
            archive_arch=amd64
            checksum=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
            ;;
        aarch64 | arm64)
            archive_arch=arm64
            checksum=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec
            ;;
        *)
            printf 'Unsupported Linux architecture for Go: %s\n' "$(uname -m)" >&2
            return 1
            ;;
    esac

    local temporary archive destination
    temporary="$(mktemp -d)"
    trap 'rm -rf "$temporary"' EXIT
    archive="$temporary/go.tar.gz"
    destination="$local_opt/go-$go_version"
    download_verified \
        "https://go.dev/dl/go$go_version.linux-$archive_arch.tar.gz" \
        "$checksum" \
        "$archive"
    tar -xzf "$archive" -C "$temporary"
    rm -rf "$destination"
    mv "$temporary/go" "$destination"
    ln -sfn "$destination/bin/go" "$local_bin/go"
    ln -sfn "$destination/bin/gofmt" "$local_bin/gofmt"
)

persist_path() {
    local marker='# Rui orb toolchain'
    local profile="$HOME/.bash_profile"
    [[ -e "$profile" ]] || profile="$HOME/.profile"
    touch "$profile"
    if ! grep -Fqx "$marker" "$profile"; then
        cat >>"$profile" <<'EOF'

# Rui orb toolchain
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
    fi
}

install_agent_skills() (
    local temporary matt_checkout humanlayer_checkout stack_checkout skills_next skills_previous
    temporary="$(mktemp -d)"
    matt_checkout="$temporary/mattpocock-skills"
    humanlayer_checkout="$temporary/humanlayer-skills"
    stack_checkout="$temporary/gh-stack"
    skills_next="$repo_root/.agents/skills.next"
    skills_previous="$repo_root/.agents/skills.previous"
    cleanup_agent_skills_install() {
        rm -rf "$temporary" "$skills_next"
        rm -f "$repo_root/.agents/skills-revisions.next"
        if [[ -d "$skills_previous" && ! -e "$repo_root/.agents/skills" ]]; then
            mv "$skills_previous" "$repo_root/.agents/skills"
        fi
    }
    trap cleanup_agent_skills_install EXIT

    git clone --quiet --depth 1 https://github.com/mattpocock/skills.git "$matt_checkout"
    git clone --quiet --depth 1 https://github.com/humanlayer/skills.git "$humanlayer_checkout"
    git clone --quiet --depth 1 https://github.com/github/gh-stack.git "$stack_checkout"

    rm -rf "$skills_next" "$skills_previous"
    mkdir -p "$skills_next"

    local source
    for source in "$matt_checkout"/skills/engineering/*; do
        if [[ -d "$source" && -f "$source/SKILL.md" ]]; then
            cp -R "$source" "$skills_next/"
        fi
    done
    cp -R "$matt_checkout/skills/productivity/grilling" "$skills_next/"
    cp -R "$matt_checkout/skills/productivity/writing-for-agents" "$skills_next/"
    cp -R "$humanlayer_checkout/plugins/visual-pr/skills/visual-pr" "$skills_next/"
    cp -R "$stack_checkout/skills/gh-stack" "$skills_next/"

    local matt_revision humanlayer_revision stack_revision
    matt_revision="$(git -C "$matt_checkout" rev-parse HEAD)"
    humanlayer_revision="$(git -C "$humanlayer_checkout" rev-parse HEAD)"
    stack_revision="$(git -C "$stack_checkout" rev-parse HEAD)"
    cat >"$repo_root/.agents/skills-revisions.next" <<EOF
https://github.com/mattpocock/skills $matt_revision
https://github.com/humanlayer/skills $humanlayer_revision
https://github.com/github/gh-stack $stack_revision
EOF

    if [[ -d "$repo_root/.agents/skills" ]]; then
        mv "$repo_root/.agents/skills" "$skills_previous"
    fi
    mv "$skills_next" "$repo_root/.agents/skills"
    rm -rf "$skills_previous"
    mv "$repo_root/.agents/skills-revisions.next" "$repo_root/.agents/skills-revisions"

    printf 'Matt Pocock skills: %s\n' "$matt_revision"
    printf 'HumanLayer skills: %s\n' "$humanlayer_revision"
    printf 'gh-stack skill: %s\n' "$stack_revision"
)

mkdir -p "$local_bin" "$local_opt"

step 'Installing system packages'
install_system_packages

step 'Installing latest agent skills'
install_agent_skills

step 'Installing pinned toolchains'
install_zig
install_go
persist_path
export PATH="$local_bin:$PATH"

step 'Fetching pinned Zig dependencies'
zig_cache="$HOME/.cache/zig"
dependency_downloads="$(mktemp -d)"
trap 'rm -rf "$dependency_downloads"' EXIT
mkdir -p "$zig_cache/tmp"
fetch_zig_dependency \
    https://github.com/openssl/openssl/releases/download/openssl-3.6.3/openssl-3.6.3.tar.gz \
    N-V-__8AAJgLCgiTl2NEdxbc2QusROj0-GIN3jrv7BgQDGwM \
    openssl-3.6.3.tar.gz
fetch_zig_dependency \
    https://www.sqlite.org/2026/sqlite-amalgamation-3530400.zip \
    N-V-__8AAGVtrgCcOcmjrOJnagmnRyMrcKaOo09KbU-vu8w8 \
    sqlite-amalgamation-3530400.zip
fetch_zig_dependency \
    https://curl.se/download/curl-8.22.0.tar.xz \
    N-V-__8AALJXUwHr71AwttzhEqqYTvFb_jz0EQ5Ou3OWpHBM \
    curl-8.22.0.tar.xz
fetch_zig_dependency \
    https://github.com/nghttp2/nghttp2/releases/download/v1.70.0/nghttp2-1.70.0.tar.xz \
    N-V-__8AACay2gDbHrByjNGWvyH8G9Gp30uRgZqobYOF1nhb \
    nghttp2-1.70.0.tar.xz
fetch_zig_dependency \
    https://github.com/JuliaStrings/utf8proc/archive/refs/tags/v2.11.3.tar.gz \
    N-V-__8AACywKABFCj0r_Y-jIWsk9ahy10zlk78hjn6S-39g \
    utf8proc-2.11.3.tar.gz
(cd "$repo_root" && zig build --global-cache-dir "$zig_cache" --fetch=all)

step 'Fetching pinned Go measurement dependencies'
GOTOOLCHAIN=local go -C "$repo_root/tests/qualification" mod download

step 'Orb setup complete'
zig version
go version
